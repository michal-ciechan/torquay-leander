---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const variations = [
  { key: 'transparent', name: 'Transparent', file: 'logo-transparent.png' },
  { key: 'outlined', name: 'White outlined bird', file: 'logo-outlined-transparent.png' },
  { key: 'outlined-full', name: 'Bird + thick word outline', file: 'logo-outlined-full-transparent.png' },
  { key: 'outlined-words', name: 'Thick word outline only', file: 'logo-outlined-words-transparent.png' },
];

---
<BaseLayout title="Logo Samples — Torquay Leander">

<section class="page-hero">
  <div class="hero-inner">
    <div class="crumb">
      <a href={`${base}/`}>Home</a>
      <span>›</span>
      <a href={`${base}/samples/`}>Samples</a>
      <span>›</span>
      <span>Logo</span>
    </div>
    <h1>Logo Picker</h1>
    <p>For each place the logo appears, the bar below previews your pick live. Choose a variation from the list under each bar, then copy or share your picks from the bottom bar.</p>
  </div>
</section>

<div x-data="logoPicker()" x-init="init()">

  <!-- NAVBAR -->
  <section class="place-section" id="nav">
    <div class="inner">
      <h2>Navbar</h2>
      <p class="place-desc">Red bar at the top of every page. Shown at real desktop size and at iPhone 15 width.</p>

      <span class="strip-caption">Desktop</span>
      <div class="strip strip-nav">
        <img :src="fileOf(sel.nav)" src={`${base}/samples/logo/logo-transparent.png`} alt="Navbar logo preview" />
        <span class="strip-brand">Torquay Leander</span>
        <span class="strip-links" aria-hidden="true">Training&ensp;Competitions&ensp;Membership</span>
        <span class="strip-cta" aria-hidden="true">Free Trial</span>
      </div>

      <span class="strip-caption">iPhone 15 width</span>
      <div class="strip strip-nav strip-phone">
        <img :src="fileOf(sel.nav)" src={`${base}/samples/logo/logo-transparent.png`} alt="Mobile navbar logo preview" />
        <span class="strip-brand">Torquay Leander</span>
        <span class="strip-burger" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>

      <div class="options">
        {variations.map((v) => (
          <button class="opt" :class={`{ picked: sel.nav === '${v.key}' }`} @click={`pick('nav', '${v.key}')`}>
            <span class="opt-thumb"><img src={`${base}/samples/logo/${v.file}`} alt={v.name} loading="lazy" /></span>
            <span class="opt-name">{v.name}</span>
            <span class="opt-check" x-show={`sel.nav === '${v.key}'`} x-cloak>✓</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <section class="place-section" id="footer">
    <div class="inner">
      <h2>Footer</h2>
      <p class="place-desc">Black footer at the bottom of every page.</p>

      <div class="strip strip-footer">
        <img :src="fileOf(sel.footer)" src={`${base}/samples/logo/logo-transparent.png`} alt="Footer logo preview" />
        <span class="strip-brand">Torquay Leander</span>
        <span class="strip-sub" aria-hidden="true">A non-profit, SwimMark registered swimming club…</span>
      </div>

      <div class="options">
        {variations.map((v) => (
          <button class="opt" :class={`{ picked: sel.footer === '${v.key}' }`} @click={`pick('footer', '${v.key}')`}>
            <span class="opt-thumb"><img src={`${base}/samples/logo/${v.file}`} alt={v.name} loading="lazy" /></span>
            <span class="opt-name">{v.name}</span>
            <span class="opt-check" x-show={`sel.footer === '${v.key}'`} x-cloak>✓</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- LOGIN -->
  <section class="place-section" id="login">
    <div class="inner">
      <h2>Members Login</h2>
      <p class="place-desc">Dark navy login page.</p>

      <div class="strip strip-login">
        <img :src="fileOf(sel.login)" src={`${base}/samples/logo/logo-transparent.png`} alt="Login logo preview" />
        <span class="strip-brand">Torquay Leander</span>
        <span class="strip-sub" aria-hidden="true">Members Login</span>
      </div>

      <div class="options">
        {variations.map((v) => (
          <button class="opt" :class={`{ picked: sel.login === '${v.key}' }`} @click={`pick('login', '${v.key}')`}>
            <span class="opt-thumb"><img src={`${base}/samples/logo/${v.file}`} alt={v.name} loading="lazy" /></span>
            <span class="opt-name">{v.name}</span>
            <span class="opt-check" x-show={`sel.login === '${v.key}'`} x-cloak>✓</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- DOWNLOADS -->
  <section class="place-section dl-section">
    <div class="inner">
      <h2>Downloads</h2>
      <p class="place-desc">Full-resolution transparent PNGs (1024px).</p>
      <div class="dl-list">
        {variations.map((v) => (
          <a class="var-dl" href={`${base}/samples/logo/${v.file}`} download>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            {v.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- floating selection bar -->
  <div class="pick-bar">
    <div class="pick-summary">
      <span class="pick-item"><b>Navbar:</b> <span x-text="label(sel.nav)"></span></span>
      <span class="pick-item"><b>Footer:</b> <span x-text="label(sel.footer)"></span></span>
      <span class="pick-item"><b>Login:</b> <span x-text="label(sel.login)"></span></span>
    </div>
    <div class="pick-actions">
      <button class="pick-btn" @click="copy()" x-text="copied ? '✓ Copied' : 'Copy'"></button>
      <button class="pick-btn pick-share" @click="share()">Share</button>
    </div>
  </div>

</div>

<script is:inline define:vars={{ base }}>
  window.logoPicker = function () {
    const NAMES = {
      transparent: 'Transparent',
      outlined: 'White outlined bird',
      'outlined-full': 'Bird + thick word outline',
      'outlined-words': 'Thick word outline only',
    };
    const FILES = {
      transparent: 'logo-transparent.png',
      outlined: 'logo-outlined-transparent.png',
      'outlined-full': 'logo-outlined-full-transparent.png',
      'outlined-words': 'logo-outlined-words-transparent.png',
    };
    return {
      sel: { nav: null, footer: null, login: null },
      copied: false,
      init() {
        const p = new URLSearchParams(location.search);
        for (const k of ['nav', 'footer', 'login']) {
          const v = p.get(k);
          if (v && NAMES[v]) this.sel[k] = v;
        }
        if (!p.toString()) {
          try {
            const saved = JSON.parse(localStorage.getItem('logo-picks') || '{}');
            for (const k of ['nav', 'footer', 'login']) if (NAMES[saved[k]]) this.sel[k] = saved[k];
          } catch {}
        }
      },
      pick(place, key) {
        this.sel[place] = key;
        try { localStorage.setItem('logo-picks', JSON.stringify(this.sel)); } catch {}
        const p = new URLSearchParams();
        for (const k of ['nav', 'footer', 'login']) if (this.sel[k]) p.set(k, this.sel[k]);
        history.replaceState(null, '', location.pathname + (p.toString() ? '?' + p.toString() : ''));
      },
      fileOf(key) { return base + '/samples/logo/' + (FILES[key] || FILES.transparent); },
      label(key) { return key ? NAMES[key] : '—'; },
      text() {
        return 'Torquay Leander logo picks\n'
          + '• Navbar: ' + this.label(this.sel.nav) + '\n'
          + '• Footer: ' + this.label(this.sel.footer) + '\n'
          + '• Login: ' + this.label(this.sel.login) + '\n'
          + location.href;
      },
      async copy() {
        try { await navigator.clipboard.writeText(this.text()); } catch {
          const t = document.createElement('textarea');
          t.value = this.text(); document.body.appendChild(t); t.select();
          document.execCommand('copy'); t.remove();
        }
        this.copied = true;
        setTimeout(() => (this.copied = false), 1800);
      },
      async share() {
        if (navigator.share) {
          try { await navigator.share({ title: 'Torquay Leander logo picks', text: this.text(), url: location.href }); } catch {}
        } else {
          this.copy();
        }
      },
    };
  };
</script>

</BaseLayout>

<style>
  .page-hero {
    background: var(--black); padding: 64px 5vw 56px;
    position: relative; overflow: hidden;
  }
  .page-hero::after {
    content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 60px;
    background: #f8fafc; clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .crumb { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.4); font-size: 0.78rem; margin-bottom: 18px; flex-wrap: wrap; }
  .crumb a { color: var(--red); text-decoration: none; }
  .crumb span { opacity: 0.5; }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -1.5px; margin-bottom: 12px; }
  .page-hero p { color: rgba(255,255,255,0.65); font-size: 1rem; max-width: 680px; line-height: 1.7; }

  .inner { max-width: 1000px; margin: 0 auto; }

  .place-section { padding: 56px 5vw 44px; background: #f8fafc; }
  .place-section:nth-of-type(even) { background: #fff; }
  .place-section h2 { font-size: clamp(1.35rem, 2.6vw, 1.8rem); font-weight: 800; letter-spacing: -0.5px; margin-bottom: 6px; }
  .place-desc { color: var(--muted); font-size: 0.92rem; line-height: 1.65; margin-bottom: 22px; }

  .strip-caption { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }

  .strip {
    display: flex; align-items: center; gap: 12px;
    width: 100%; border-radius: 12px;
    padding: 11px 18px; margin-bottom: 18px;
    box-shadow: 0 6px 22px rgba(0,0,0,0.12);
  }
  .strip img { height: 42px; width: auto; flex-shrink: 0; }
  .strip-brand { color: #fff; font-weight: 700; font-size: 1rem; letter-spacing: -0.3px; white-space: nowrap; }
  .strip-links { margin-left: auto; color: rgba(255,255,255,0.85); font-weight: 600; font-size: 0.82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .strip-cta { background: #fff; color: var(--black); font-weight: 700; font-size: 0.8rem; border-radius: 8px; padding: 8px 14px; white-space: nowrap; }
  .strip-sub { margin-left: auto; color: rgba(255,255,255,0.5); font-size: 0.78rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .strip-nav { background: var(--red); }
  .strip-footer { background: var(--black); }
  .strip-login { background: #0b1220; }

  .strip-phone { width: 393px; max-width: 100%; padding: 9px 14px; }
  .strip-phone img { height: 36px; }
  .strip-phone .strip-brand { font-size: 0.9rem; }
  .strip-burger { margin-left: auto; display: flex; flex-direction: column; gap: 4px; }
  .strip-burger i { display: block; width: 20px; height: 2px; background: #fff; border-radius: 2px; }

  .options { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; margin-top: 8px; }
  .opt {
    position: relative; display: flex; flex-direction: column; align-items: stretch; gap: 0;
    font: inherit; text-align: left; cursor: pointer;
    background: #fff; border: 2px solid var(--border); border-radius: 12px; overflow: hidden;
    padding: 0; transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .opt:hover { border-color: var(--red); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(220,38,38,0.12); }
  .opt.picked { border-color: #16a34a; box-shadow: 0 0 0 3px rgba(22,163,74,0.2); }
  .opt-thumb {
    display: flex; align-items: center; justify-content: center; padding: 14px; min-height: 110px;
    background: repeating-conic-gradient(#e2e8f0 0% 25%, #f8fafc 0% 50%) 50% / 20px 20px;
  }
  .opt-thumb img { max-height: 84px; max-width: 100%; width: auto; }
  .opt-name { padding: 10px 12px; font-size: 0.8rem; font-weight: 700; color: var(--text); border-top: 1.5px solid var(--border); background: #fff; }
  .opt-check {
    position: absolute; top: 8px; right: 8px;
    width: 22px; height: 22px; border-radius: 50%;
    background: #16a34a; color: #fff; font-size: 0.75rem; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
  }

  .dl-section { padding-bottom: 150px; }
  .dl-list { display: flex; flex-wrap: wrap; gap: 10px; }
  .var-dl {
    display: inline-flex; align-items: center; gap: 7px;
    background: var(--red-light); color: var(--red);
    border-radius: 8px; padding: 8px 14px; font-size: 0.8rem; font-weight: 700;
    text-decoration: none; transition: background 0.2s, color 0.2s;
  }
  .var-dl:hover { background: var(--red); color: #fff; }

  .pick-bar {
    position: fixed; left: 50%; bottom: 16px; transform: translateX(-50%);
    z-index: 60; width: min(960px, calc(100vw - 24px));
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    background: rgba(10,10,10,0.94); backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.14); border-radius: 14px;
    padding: 12px 18px; color: #fff;
    box-shadow: 0 12px 40px rgba(0,0,0,0.35);
  }
  .pick-summary { display: flex; gap: 18px; flex-wrap: wrap; min-width: 0; font-size: 0.82rem; }
  .pick-item { color: rgba(255,255,255,0.85); white-space: nowrap; }
  .pick-item b { color: #fff; font-weight: 800; }
  .pick-actions { display: flex; gap: 8px; flex-shrink: 0; }
  .pick-btn {
    font: inherit; font-size: 0.8rem; font-weight: 700; cursor: pointer;
    background: #fff; color: var(--black); border: none; border-radius: 8px; padding: 8px 16px;
    transition: transform 0.15s, background 0.15s;
  }
  .pick-btn:hover { transform: translateY(-1px); }
  .pick-share { background: var(--red); color: #fff; }

  [x-cloak] { display: none !important; }

  @media (max-width: 860px) {
    .strip-links, .strip-cta { display: none; }
    .options { grid-template-columns: repeat(2, 1fr); }
    .pick-bar { flex-direction: column; align-items: stretch; gap: 10px; padding: 10px 14px; }
    .pick-summary { gap: 10px; font-size: 0.76rem; justify-content: center; }
    .pick-actions { justify-content: center; }
  }
</style>
