---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const variations = [
  {
    key: 'red',
    name: 'Red background',
    desc: 'Standard logo flattened onto the club scarlet (#dc2626).',
    file: 'logo-red.png',
    previewBg: 'red',
  },
  {
    key: 'white',
    name: 'White background',
    desc: 'Standard logo flattened onto white — for print, documents and light backgrounds.',
    file: 'logo-white.png',
    previewBg: 'white',
  },
  {
    key: 'transparent',
    name: 'Transparent',
    desc: 'Standard logo with transparent background — takes the colour of whatever sits behind it.',
    file: 'logo-transparent.png',
    previewBg: 'checker',
  },
  {
    key: 'outlined',
    name: 'White outlined bird — transparent',
    desc: 'The bird carries a white keyline matching the lettering, so the full logo reads on dark or busy backgrounds.',
    file: 'logo-outlined-transparent.png',
    previewBg: 'checker',
  },
];
---
<BaseLayout title="Logo Samples — Torquay Leander">

<section class="page-hero">
  <div class="hero-inner">
    <div class="crumb">
      <a href={`${base}/`}>Home</a>
      <span>›</span>
      <a href={`${base}/samples/`}>Samples</a>
      <span>›</span>
      <span>Logo</span>
    </div>
    <h1>Logo Variations</h1>
    <p>Each variation is shown big, then in place — navbar at desktop size, navbar at iPhone 15 width, and the footer. Click a strip to pick that variation for that spot, then copy or share your picks from the bar below.</p>
  </div>
</section>

<div x-data="logoPicker()" x-init="init()">

  {variations.map((v) => (
    <section class="var-section" id={v.key}>
      <div class="inner">
        <div class="var-head">
          <h2>{v.name}</h2>
          <p>{v.desc}</p>
          <a class="var-dl" href={`${base}/samples/logo/${v.file}`} download>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download PNG (1024px)
          </a>
        </div>

        <div class="var-layout">
          <a class={`var-preview bg-${v.previewBg}`} href={`${base}/samples/logo/${v.file}`} target="_blank" rel="noopener">
            <img src={`${base}/samples/logo/${v.file}`} alt={`Torquay Leander logo — ${v.name}`} loading="lazy" />
          </a>

          <div class="strips">

            <div class="strip-block">
              <span class="strip-caption">Navbar — desktop size <em>(click to pick for navbar)</em></span>
              <button
                class="strip strip-nav"
                :class={`{ picked: sel.nav === '${v.key}' }`}
                @click={`pick('nav', '${v.key}')`}
              >
                <img src={`${base}/samples/logo/${v.file}`} alt="" />
                <span class="strip-brand">Torquay Leander</span>
                <span class="strip-links" aria-hidden="true">Training&ensp;Competitions&ensp;Membership</span>
                <span class="strip-cta" aria-hidden="true">Free Trial</span>
                <span class="picked-badge" x-show={`sel.nav === '${v.key}'`} x-cloak>✓ Navbar</span>
              </button>
            </div>

            <div class="strip-block">
              <span class="strip-caption">Navbar — iPhone 15 width <em>(click to pick for navbar)</em></span>
              <button
                class="strip strip-nav strip-phone"
                :class={`{ picked: sel.nav === '${v.key}' }`}
                @click={`pick('nav', '${v.key}')`}
              >
                <img src={`${base}/samples/logo/${v.file}`} alt="" />
                <span class="strip-brand">Torquay Leander</span>
                <span class="strip-burger" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="picked-badge" x-show={`sel.nav === '${v.key}'`} x-cloak>✓ Navbar</span>
              </button>
            </div>

            <div class="strip-block">
              <span class="strip-caption">Footer <em>(click to pick for footer)</em></span>
              <button
                class="strip strip-footer"
                :class={`{ picked: sel.footer === '${v.key}' }`}
                @click={`pick('footer', '${v.key}')`}
              >
                <img src={`${base}/samples/logo/${v.file}`} alt="" />
                <span class="strip-brand">Torquay Leander</span>
                <span class="strip-sub" aria-hidden="true">A non-profit, SwimMark registered swimming club…</span>
                <span class="picked-badge" x-show={`sel.footer === '${v.key}'`} x-cloak>✓ Footer</span>
              </button>
            </div>

            <div class="strip-block">
              <span class="strip-caption">Members login page <em>(click to pick for login)</em></span>
              <button
                class="strip strip-login"
                :class={`{ picked: sel.login === '${v.key}' }`}
                @click={`pick('login', '${v.key}')`}
              >
                <img src={`${base}/samples/logo/${v.file}`} alt="" />
                <span class="strip-brand">Torquay Leander</span>
                <span class="strip-sub" aria-hidden="true">Members Login</span>
                <span class="picked-badge" x-show={`sel.login === '${v.key}'`} x-cloak>✓ Login</span>
              </button>
            </div>

          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- floating selection bar -->
  <div class="pick-bar">
    <div class="pick-summary">
      <span class="pick-item"><b>Navbar:</b> <span x-text="label(sel.nav)"></span></span>
      <span class="pick-item"><b>Footer:</b> <span x-text="label(sel.footer)"></span></span>
      <span class="pick-item"><b>Login:</b> <span x-text="label(sel.login)"></span></span>
    </div>
    <div class="pick-actions">
      <button class="pick-btn" @click="copy()" x-text="copied ? '✓ Copied' : 'Copy'"></button>
      <button class="pick-btn pick-share" @click="share()">Share</button>
    </div>
  </div>

</div>

<script is:inline>
  window.logoPicker = function () {
    const NAMES = {
      red: 'Red background',
      white: 'White background',
      transparent: 'Transparent',
      outlined: 'White outlined bird — transparent',
    };
    return {
      sel: { nav: null, footer: null, login: null },
      copied: false,
      init() {
        const p = new URLSearchParams(location.search);
        for (const k of ['nav', 'footer', 'login']) {
          const v = p.get(k);
          if (v && NAMES[v]) this.sel[k] = v;
        }
        if (!p.toString()) {
          try {
            const saved = JSON.parse(localStorage.getItem('logo-picks') || '{}');
            for (const k of ['nav', 'footer', 'login']) if (NAMES[saved[k]]) this.sel[k] = saved[k];
          } catch {}
        }
      },
      pick(place, key) {
        this.sel[place] = this.sel[place] === key ? null : key;
        try { localStorage.setItem('logo-picks', JSON.stringify(this.sel)); } catch {}
        const p = new URLSearchParams();
        for (const k of ['nav', 'footer', 'login']) if (this.sel[k]) p.set(k, this.sel[k]);
        history.replaceState(null, '', location.pathname + (p.toString() ? '?' + p.toString() : ''));
      },
      label(key) { return key ? NAMES[key] : '—'; },
      text() {
        return 'Torquay Leander logo picks\n'
          + '• Navbar: ' + this.label(this.sel.nav) + '\n'
          + '• Footer: ' + this.label(this.sel.footer) + '\n'
          + '• Login: ' + this.label(this.sel.login) + '\n'
          + location.href;
      },
      async copy() {
        try { await navigator.clipboard.writeText(this.text()); } catch {
          const t = document.createElement('textarea');
          t.value = this.text(); document.body.appendChild(t); t.select();
          document.execCommand('copy'); t.remove();
        }
        this.copied = true;
        setTimeout(() => (this.copied = false), 1800);
      },
      async share() {
        if (navigator.share) {
          try { await navigator.share({ title: 'Torquay Leander logo picks', text: this.text(), url: location.href }); } catch {}
        } else {
          this.copy();
        }
      },
    };
  };
</script>

</BaseLayout>

<style>
  .page-hero {
    background: var(--black); padding: 64px 5vw 56px;
    position: relative; overflow: hidden;
  }
  .page-hero::after {
    content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 60px;
    background: #f8fafc; clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .crumb { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.4); font-size: 0.78rem; margin-bottom: 18px; flex-wrap: wrap; }
  .crumb a { color: var(--red); text-decoration: none; }
  .crumb span { opacity: 0.5; }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -1.5px; margin-bottom: 12px; }
  .page-hero p { color: rgba(255,255,255,0.65); font-size: 1rem; max-width: 680px; line-height: 1.7; }

  .inner { max-width: 1100px; margin: 0 auto; }

  .var-section { padding: 56px 5vw 40px; background: #f8fafc; }
  .var-section:nth-of-type(even) { background: #fff; }
  .var-section:last-of-type { padding-bottom: 140px; }
  .var-head { margin-bottom: 24px; }
  .var-head h2 { font-size: clamp(1.35rem, 2.6vw, 1.8rem); font-weight: 800; letter-spacing: -0.5px; margin-bottom: 6px; }
  .var-head p { color: var(--muted); font-size: 0.92rem; line-height: 1.65; max-width: 640px; margin-bottom: 12px; }
  .var-dl {
    display: inline-flex; align-items: center; gap: 7px;
    background: var(--red-light); color: var(--red);
    border-radius: 8px; padding: 8px 14px; font-size: 0.8rem; font-weight: 700;
    text-decoration: none; transition: background 0.2s, color 0.2s;
  }
  .var-dl:hover { background: var(--red); color: #fff; }

  .var-layout { display: grid; grid-template-columns: 320px 1fr; gap: 24px; align-items: start; }
  .var-preview {
    display: flex; align-items: center; justify-content: center;
    padding: 26px; min-height: 240px; border-radius: 16px;
    border: 1.5px solid var(--border);
  }
  .var-preview img { max-height: 190px; max-width: 100%; width: auto; }
  .bg-red { background: var(--red); }
  .bg-white { background: #fff; }
  .bg-checker {
    background:
      repeating-conic-gradient(#e2e8f0 0% 25%, #f8fafc 0% 50%)
      50% / 24px 24px;
  }

  .strips { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .strip-block { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .strip-caption { font-size: 0.72rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); }
  .strip-caption em { font-style: normal; text-transform: none; letter-spacing: 0; font-weight: 600; color: #94a3b8; }

  .strip {
    position: relative; display: flex; align-items: center; gap: 12px;
    width: 100%; text-align: left; border: 2px solid transparent; border-radius: 12px;
    padding: 11px 18px; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s;
    font: inherit;
  }
  .strip:hover { box-shadow: 0 6px 22px rgba(0,0,0,0.18); }
  .strip.picked { border-color: #16a34a; box-shadow: 0 0 0 3px rgba(22,163,74,0.25); }
  .strip img { height: 42px; width: auto; flex-shrink: 0; }
  .strip-brand { color: #fff; font-weight: 700; font-size: 1rem; letter-spacing: -0.3px; white-space: nowrap; }
  .strip-links { margin-left: auto; color: rgba(255,255,255,0.85); font-weight: 600; font-size: 0.82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .strip-cta { background: #fff; color: var(--black); font-weight: 700; font-size: 0.8rem; border-radius: 8px; padding: 8px 14px; white-space: nowrap; }
  .strip-sub { margin-left: auto; color: rgba(255,255,255,0.5); font-size: 0.78rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .strip-nav { background: var(--red); }
  .strip-footer { background: var(--black); }
  .strip-login { background: #0b1220; }

  .strip-phone { width: 393px; max-width: 100%; padding: 9px 14px; }
  .strip-phone img { height: 36px; }
  .strip-phone .strip-brand { font-size: 0.9rem; }
  .strip-burger { margin-left: auto; display: flex; flex-direction: column; gap: 4px; }
  .strip-burger i { display: block; width: 20px; height: 2px; background: #fff; border-radius: 2px; }

  .picked-badge {
    position: absolute; top: -9px; right: 10px;
    background: #16a34a; color: #fff; font-size: 0.66rem; font-weight: 800;
    border-radius: 999px; padding: 3px 9px; letter-spacing: 0.5px;
  }

  .pick-bar {
    position: fixed; left: 50%; bottom: 16px; transform: translateX(-50%);
    z-index: 60; width: min(960px, calc(100vw - 24px));
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    background: rgba(10,10,10,0.94); backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.14); border-radius: 14px;
    padding: 12px 18px; color: #fff;
    box-shadow: 0 12px 40px rgba(0,0,0,0.35);
  }
  .pick-summary { display: flex; gap: 18px; flex-wrap: wrap; min-width: 0; font-size: 0.82rem; }
  .pick-item { color: rgba(255,255,255,0.85); white-space: nowrap; }
  .pick-item b { color: #fff; font-weight: 800; }
  .pick-actions { display: flex; gap: 8px; flex-shrink: 0; }
  .pick-btn {
    font: inherit; font-size: 0.8rem; font-weight: 700; cursor: pointer;
    background: #fff; color: var(--black); border: none; border-radius: 8px; padding: 8px 16px;
    transition: transform 0.15s, background 0.15s;
  }
  .pick-btn:hover { transform: translateY(-1px); }
  .pick-share { background: var(--red); color: #fff; }

  [x-cloak] { display: none !important; }

  @media (max-width: 860px) {
    .var-layout { grid-template-columns: 1fr; }
    .var-preview { min-height: 200px; }
    .strip-links, .strip-cta { display: none; }
    .pick-bar { flex-direction: column; align-items: stretch; gap: 10px; padding: 10px 14px; }
    .pick-summary { gap: 10px; font-size: 0.76rem; justify-content: center; }
    .pick-actions { justify-content: center; }
  }
</style>
