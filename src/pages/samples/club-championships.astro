---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const variants = [
  {
    name: 'Full event names (live)',
    desc: 'Event names written out in the style the page already used — "100m Individual Medley", "25m Backstroke (7 & under)".',
    programme: [
      { date: 'Thursday 5th Nov', events: ['400m Freestyle'] },
      { date: 'Monday 9th Nov', events: ['100m Individual Medley', '25m Backstroke (7 & under)', '200m Breaststroke', '50m Backstroke', '100m Freestyle'] },
      { date: 'Sunday 15th Nov', session: 'Session 1', events: ['25m Butterfly (7 & under)', '50m Butterfly', '100m Backstroke', '200m Freestyle'] },
      { date: 'Sunday 15th Nov', session: 'Session 2', events: ['25m Breaststroke (7 & under)', '50m Freestyle', '100m Breaststroke'] },
      { date: 'Thursday 19th Nov', events: ['200m Individual Medley', '25m Freestyle (7 & under)', '50m Breaststroke', '200m Backstroke', '100m Butterfly'] },
    ],
  },
  {
    name: 'Short names — as in your email',
    desc: 'Event names exactly as written in the mail — "100IM", "25 Backstroke (7 and under)". More compact, assumes readers know the shorthand.',
    programme: [
      { date: 'Thursday 5th November', events: ['400m Freestyle'] },
      { date: 'Monday 9th November', events: ['100IM', '25 Backstroke (7 and under)', '200 Breaststroke', '50 Backstroke', '100 Freestyle'] },
      { date: 'Sunday 15th November', session: 'Session 1', events: ['25 Butterfly (7 and under)', '50 Butterfly', '100 Backstroke', '200 Freestyle'] },
      { date: 'Sunday 15th November', session: 'Session 2', events: ['25m Breaststroke (7 and under)', '50m Freestyle', '100 Breaststroke'] },
      { date: 'Thursday 19th November', events: ['200IM', '25 Freestyle (7 and under)', '50 Breaststroke', '200 Backstroke', '100 Butterfly'] },
    ],
  },
];
---
<BaseLayout title="Club Championships Sample — Torquay Leander">

<section class="page-hero">
  <div class="hero-inner">
    <div class="crumb">
      <a href={`${base}/`}>Home</a>
      <span>›</span>
      <a href={`${base}/samples/`}>Samples</a>
      <span>›</span>
      <span>Club Championships</span>
    </div>
    <h1>Championships Programme — Naming</h1>
    <p>The 2026 programme shown two ways: event names written out in full (what the live page uses), and the short names exactly as they appeared in the email. Same dates and sessions in both.</p>
  </div>
</section>

{variants.map((v) => (
  <section class="programme-sample">
    <div class="inner">
      <div class="variant-head">
        <h2>{v.name}</h2>
        <p>{v.desc}</p>
      </div>
      <div class="prog-list">
        {v.programme.map((day) => (
          <div class="prog-day">
            <div class="prog-head">
              <span class="prog-date">{day.date}</span>
              {day.session && <span class="prog-session">{day.session}</span>}
            </div>
            <div class="prog-events">
              {day.events.map((e) => <span class="event-tag">{e}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
))}

<section class="live-link">
  <div class="inner">
    <a class="note-link" href={`${base}/competitions/club-championships/`}>View the live Club Championships page →</a>
  </div>
</section>

</BaseLayout>

<style>
  .page-hero {
    background: var(--black); padding: 64px 5vw 56px;
    position: relative; overflow: hidden;
  }
  .page-hero::after {
    content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 60px;
    background: #f8fafc; clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .crumb { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.4); font-size: 0.78rem; margin-bottom: 18px; flex-wrap: wrap; }
  .crumb a { color: var(--red); text-decoration: none; }
  .crumb span { opacity: 0.5; }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -1.5px; margin-bottom: 12px; }
  .page-hero p { color: rgba(255,255,255,0.65); font-size: 1rem; max-width: 660px; line-height: 1.7; }

  .inner { max-width: 1100px; margin: 0 auto; }

  .programme-sample { padding: 56px 5vw 24px; background: #f8fafc; }
  .programme-sample:nth-of-type(even) { background: #fff; }
  .variant-head { margin-bottom: 24px; }
  .variant-head h2 { font-size: clamp(1.3rem, 2.5vw, 1.7rem); font-weight: 800; letter-spacing: -0.5px; margin-bottom: 6px; }
  .variant-head p { color: var(--muted); font-size: 0.92rem; line-height: 1.65; max-width: 680px; }

  .prog-list { display: flex; flex-direction: column; gap: 16px; }
  .prog-day { background: #fff; border: 1.5px solid var(--border); border-radius: 14px; padding: 22px 24px; }
  .programme-sample:nth-of-type(even) .prog-day { background: #f8fafc; }
  .prog-head { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
  .prog-date { font-size: 1.05rem; font-weight: 800; color: var(--text); }
  .prog-session { background: var(--red-light); color: var(--red-dark); border-radius: 999px; padding: 5px 13px; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; }
  .prog-events { display: flex; flex-wrap: wrap; gap: 8px; }
  .event-tag { background: #f1f5f9; border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px; font-size: 0.8rem; font-weight: 600; color: var(--text); }
  .programme-sample:nth-of-type(even) .event-tag { background: #fff; }

  .live-link { padding: 24px 5vw 80px; background: #fff; }
  .note-link { color: var(--red); font-weight: 700; font-size: 0.92rem; text-decoration: none; }
  .note-link:hover { text-decoration: underline; }
</style>
