---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DevonToggle from '../../components/DevonToggle.astro';
// Transcribed from the Devon County ASA PDF (public/docs/). Update the JSON
// each season when Devon reissue the sheet — the page reads everything from it.
import devonData from '../../data/devon-times-2027.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ageOpts = devonData.ageBands.map((a, i) => ({ value: i, label: a === '17ov' ? '17+' : a }));
const strokeOpts = ['Freestyle', 'Backstroke', 'Breaststroke', 'Butterfly', 'Ind Medley'].map((s) => ({ value: s, label: s === 'Ind Medley' ? 'IM' : s }));
const distOpts = [50, 100, 200, 400, 800, 1500].map((d) => ({ value: d, label: `${d}m` }));
---
<BaseLayout title="Devon Qualifying Times — Torquay Leander">

<section class="dt-hero">
  <div class="dt-inner">
    <div class="crumb">
      <a href={`${base}/`}>Home</a>
      <span>›</span>
      <a href={`${base}/competitions/`}>Competitions</a>
      <span>›</span>
      <span>Devon Qualifying Times</span>
    </div>
    <h1>Devon Championship Qualifying Times</h1>
    <p>The 2027 Devon County ASA consideration times. Use the filters to find the times that apply to your swimmer — ages are as at 31st December 2027.</p>
    <a class="pdf-link" href={`${base}/docs/2027-Devon-Championship-Qualifying-Times-V1.pdf`} target="_blank" rel="noopener noreferrer">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>
      View the official PDF
    </a>
  </div>
</section>

<section class="dt-body" x-data={`devonGrid(${JSON.stringify(devonData)})`} x-cloak>
  <div class="dt-inner">

    <div class="picker-bar">
      <DevonToggle label="Sex" model="sex" options={[{ value: 'male', label: 'Male' }, { value: 'female', label: 'Female' }]} />
      <DevonToggle label="Pool" model="course" options={[{ value: '25m', label: '25m' }, { value: '50m', label: '50m' }]} />
      <DevonToggle label="Age (as at 31 Dec 2027)" model="ages" options={ageOpts} multi />
      <DevonToggle label="Stroke" model="strokes" options={strokeOpts} multi />
      <DevonToggle label="Distance" model="dists" options={distOpts} multi />
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="event-col">Event</th>
            <template x-for="i in visibleAges()" :key="i">
              <th x-text="ageBands[i] === '17ov' ? '17+' : ageBands[i] + ' yrs'"></th>
            </template>
          </tr>
        </thead>
        <tbody>
          <template x-for="ev in filteredEvents()" :key="ev.name">
            <tr>
              <td class="event-col" x-text="ev.name"></td>
              <template x-for="i in visibleAges()" :key="i">
                <td x-text="cell(ev, i) || '—'" :class="{empty: !cell(ev, i)}"></td>
              </template>
            </tr>
          </template>
        </tbody>
      </table>
      <p class="no-results" x-show="filteredEvents().length === 0">
        No events match those filters — try widening the stroke or distance selection.
      </p>
    </div>
    <p class="table-hint">Scroll sideways on a phone to see older age groups →</p>

    <div class="rules-card">
      <h3>Entry requirements</h3>
      <ul>
        <li>Entry times must have been achieved since <strong>1st March 2026</strong> in Licensed meets (levels 1–4) and appear on the British Rankings list.</li>
        <li>Entries close <strong>16th December 2026</strong>.</li>
        <li>Ages are taken as at 31st December 2027.</li>
      </ul>
      <p>Not sure what to enter? <strong>Speak to your coach</strong> — or read our <a href={`${base}/competitions/competition-guide/`}>competition guide</a>.</p>
    </div>

  </div>
</section>

</BaseLayout>

<script is:inline>
  function devonGrid(data) {
    return {
      ageBands: data.ageBands,
      events: data.events,
      sex: 'male',
      course: '25m',
      ages: [],
      strokes: [],
      dists: [],
      visibleAges() {
        const all = this.ageBands.map((_, i) => i);
        return this.ages.length ? all.filter((i) => this.ages.includes(i)) : all;
      },
      cell(ev, i) {
        const c = ev.courses.find((c) => c.course === this.course);
        return c ? c[this.sex][i].time : null;
      },
      filteredEvents() {
        return this.events.filter((ev) => {
          if (this.strokes.length && !this.strokes.includes(ev.stroke)) return false;
          if (this.dists.length && !this.dists.includes(ev.distance)) return false;
          return ev.courses.some((c) => c.course === this.course);
        });
      },
    };
  }
</script>

<style>
  .dt-hero { background: var(--black); padding: 56px 5vw 44px; position: relative; overflow: hidden; }
  .dt-hero::after { content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 50px; background: #f8fafc; clip-path: polygon(0 100%, 100% 0, 100% 100%); }
  .dt-inner { max-width: 1100px; margin: 0 auto; }
  .crumb { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.4); font-size: 0.78rem; margin-bottom: 16px; }
  .crumb a { color: var(--red); text-decoration: none; }
  .crumb span { opacity: 0.5; }
  .dt-hero h1 { color: #fff; font-size: clamp(1.7rem, 3.4vw, 2.5rem); font-weight: 900; letter-spacing: -1px; margin-bottom: 10px; }
  .dt-hero p { color: rgba(255,255,255,0.65); font-size: 0.98rem; max-width: 580px; line-height: 1.6; margin-bottom: 18px; }
  .pdf-link { display: inline-flex; align-items: center; gap: 8px; color: #f87171; font-weight: 700; font-size: 0.85rem; text-decoration: none; }
  .pdf-link:hover { text-decoration: underline; }

  .dt-body { background: #f8fafc; padding: 40px 5vw 80px; }

  .picker-bar {
    background: #fff; border: 1.5px solid var(--border); border-radius: 16px;
    padding: 22px 24px; display: flex; flex-wrap: wrap; gap: 18px 28px;
    margin-bottom: 20px;
  }

  .table-wrap { background: #fff; border: 1.5px solid var(--border); border-radius: 14px; overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; }
  th, td { padding: 10px 14px; text-align: right; font-size: 0.83rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  thead th { background: #f1f5f9; color: var(--muted); font-weight: 700; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; position: sticky; top: 0; }
  tbody tr:nth-child(even) { background: #f8fafc; }
  tbody td { color: var(--text); font-weight: 600; border-top: 1px solid var(--border); }
  td.empty { color: #cbd5e1; }
  .event-col { text-align: left; font-weight: 800; position: sticky; left: 0; background: inherit; z-index: 1; }
  thead .event-col { background: #f1f5f9; z-index: 2; }
  .no-results { text-align: center; color: var(--muted); padding: 40px 20px; }
  .table-hint { color: var(--muted); font-size: 0.78rem; margin-top: 10px; }

  .rules-card { background: #fff; border: 1.5px solid var(--border); border-radius: 16px; padding: 26px 28px; margin-top: 28px; max-width: 760px; }
  .rules-card h3 { font-size: 1.05rem; font-weight: 800; color: var(--text); margin-bottom: 12px; }
  .rules-card ul { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
  .rules-card li { padding-left: 20px; position: relative; color: var(--muted); font-size: 0.9rem; line-height: 1.6; }
  .rules-card li::before { content: ''; position: absolute; left: 0; top: 9px; width: 8px; height: 8px; border-radius: 50%; background: var(--red); }
  .rules-card strong { color: var(--text); }
  .rules-card p { color: var(--muted); font-size: 0.9rem; line-height: 1.6; }
  .rules-card a { color: var(--red); font-weight: 700; text-decoration: none; }
  .rules-card a:hover { text-decoration: underline; }

  @media (max-width: 700px) {
    .dt-body { padding-left: 20px; padding-right: 20px; }
    .picker-bar { padding: 18px 16px; }
  }
</style>
