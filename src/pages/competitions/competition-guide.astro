---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const levels = [
  { n: 1, course: 'Long Course (50m)', text: 'Competitions used for National, Regional and County Championships. These events allow swimmers to achieve qualifying times for major championships.' },
  { n: 2, course: 'Short Course (25m)', text: 'Competitions used for National, Regional and County Championships. They provide qualifying opportunities for major championships in a 25m pool.' },
  { n: 3, course: '25m or 50m pools', text: 'These competitions allow swimmers to achieve qualifying times for County and Regional Championships, as well as higher-level meets.' },
  { n: 4, course: 'Entry level', text: 'Entry-level licensed competitions designed for developing swimmers — an introduction to racing outside their own club and an excellent stepping stone towards Level 3.' },
];

const startSteps = [
  { n: 1, title: 'Take your place', text: 'Swimmers take their place on the starting block or platform — on the deck, or in the water for backstroke. Competitors should remove all excess clothing except their competition swimwear.' },
  { n: 2, title: 'Long whistle', text: 'A long whistle tells swimmers to get ready. The referee stretches out an arm — this signals that the swimmers are now under the starter\'s control.' },
  { n: 3, title: '"Take your marks"', text: 'On the starter\'s command "take your marks", swimmers assume the starting position — one foot in front of the starting platform, or one hand on the wall for those starting in the water — and wait.' },
  { n: 4, title: 'The start signal', text: 'When the starting signal sounds, the race begins. The referee initiates each heat and the final race using short blasts on a whistle to give signals to swimmers.' },
];

const strokes = [
  { icon: '🦋', name: 'Butterfly', text: 'Both arms recover over the water together, with a simultaneous dolphin kick.' },
  { icon: '🔙', name: 'Backstroke', text: 'Swum on the back throughout the race — swimmers push off on their back and stay there.' },
  { icon: '🐸', name: 'Breaststroke', text: 'Simultaneous arm and leg movements, with the body kept on the breast.' },
  { icon: '🏊', name: 'Freestyle', text: 'Any stroke may be used — almost all swimmers choose front crawl for speed.' },
];

const teamManager = {
  name: 'Team Manager (TM)',
  icon: '🛡️',
  text: 'One of the most important roles at any gala. Team Managers are trained volunteers responsible for the welfare, safety and organisation of our swimmers throughout the competition. Every Team Manager has completed Swim England training and holds an enhanced DBS check.',
  duties: [
    'Looking after swimmers throughout the day',
    'Acting in the swimmer\'s best interests when parents aren\'t present',
    'Making sure swimmers are ready for warm-up and races on time',
    'Escorting swimmers to marshalling',
    'Supporting the coaching team',
  ],
  footer: 'Without Team Managers, the club would be unable to attend competitions. We always aim to have both male and female Team Managers available wherever possible.',
};

const roles = [
  {
    icon: '📣',
    name: 'Coach',
    text: 'Our coaches prepare swimmers before each race, oversee warm-ups and cool-downs, and provide feedback afterwards. They help swimmers understand their race plan and offer encouragement and technical advice throughout the day.',
  },
  {
    icon: '🏁',
    name: 'Starter',
    text: 'The Starter is responsible for ensuring each race begins fairly and safely by giving the official start.',
  },
  {
    icon: '⏱️',
    name: 'Timekeepers',
    text: 'Timekeepers record swimmers\' finishing times. At many competitions electronic timing equipment is used, with manual timekeepers providing an important backup. The Head Timekeeper oversees the timing team and ensures all recorded times are accurate.',
  },
  {
    icon: '⚖️',
    name: 'Judges and Referees',
    text: 'Judges and Referees ensure every race is conducted fairly and according to Swim England rules. Officials observe starts, turns, finishes and swimming technique. Any rule infringements are reported to the Referee, who makes the final decision regarding any disqualification.',
  },
];

const kit = [
  { emoji: '🩱', text: 'Two swimsuits or racing costumes (if you have a separate race suit)' },
  { emoji: '🥽', text: 'Two pairs of goggles' },
  { emoji: '🧢', text: 'Two club swim hats' },
  { emoji: '🛁', text: 'Two towels' },
  { emoji: '👕', text: 'Club T-shirt or hoodie' },
  { emoji: '🩴', text: 'Poolside footwear' },
  { emoji: '🥤', text: 'Plenty of water or sugar-free drinks' },
  { emoji: '🍎', text: 'Healthy snacks such as fruit, cereal bars, popcorn or rice cakes' },
  { emoji: '🥪', text: 'Lunch for full-day competitions (sandwiches, pasta, wraps etc.)' },
  { emoji: '🎒', text: 'A large bag to carry everything' },
  { emoji: '📱', text: 'Mobile phone — only if permitted by the venue; many pools do not allow phones on poolside' },
];

const galaDay = [
  { title: 'Arrival', text: 'Arrive at the venue in good time and report to one of our Team Managers. They will direct swimmers to the changing rooms and let you know where the team is based for the day.' },
  { title: 'Warm-up', text: 'Swimmers complete a supervised warm-up before racing. Boys\' and girls\' warm-ups are usually held separately, and Team Managers or coaches will tell swimmers when to report. The coach will explain exactly what swimmers need to do during the warm-up.' },
  { title: 'Before racing', text: 'After warming up, swimmers should dry off, change into their racing costume if required, and relax with the rest of the team. Many swimmers spend this time chatting with friends, reading, playing cards or listening to music while waiting to be called.' },
  { title: 'Marshalling', text: 'When it\'s time for a race, the Team Manager will take swimmers to the coach for a final briefing before escorting them to marshalling. Marshalling is where swimmers are organised into heats before being taken to the starting blocks.' },
  { title: 'The race', text: 'Once called forward, swimmers compete in their race.' },
  { title: 'After the race', text: 'The coach will provide feedback, discussing what went well and areas for improvement. Where facilities are available, swimmers may complete a warm-down swim before returning to the team area to dry off, refuel and prepare for their next event.' },
  { title: 'Going home', text: 'Once swimmers have completed all of their races, they must let their Team Manager know before leaving with their parent or guardian.' },
];

const handyLinks = [
  { name: 'Best individual times', desc: 'Check a swimmer\'s best licensed times', url: 'http://www.swimmingresults.org/individualbest/' },
  { name: 'Individual rankings', desc: 'Rankings by stroke and distance at national, regional, county and club level', url: 'http://www.swimmingresults.org/individualrankings/' },
  { name: 'Membership check', desc: 'Look up an ASA / Swim England membership number', url: 'https://www.swimmingresults.org/membershipcheck/' },
  { name: 'Licensed meets', desc: 'Full list of available licensed meets', url: 'https://www.swimmingresults.org/licensed_meets/' },
];
---
<BaseLayout title="Competition Guide — Torquay Leander">

<section class="page-hero">
  <div class="hero-inner">
    <div class="crumb">
      <a href={`${base}/`}>Home</a>
      <span>›</span>
      <a href={`${base}/competitions/`}>Competitions</a>
      <span>›</span>
      <span>Competition Guide</span>
    </div>
    <h1>Swimming Galas — A Parent's Guide</h1>
    <p>Everything you need to know before your first meet with Torquay Leander — what a gala is, how racing works, who does what, and what to bring on the day.</p>
  </div>
</section>

<!-- INTRO -->
<section class="intro">
  <div class="inner intro-inner">
    <p class="label">Your First Gala</p>
    <p class="intro-text">Entering competitions for the first time can be quite daunting — both for the swimmer and for parents. At Torquay Leander we're here to support you as much as possible, so if you have any questions please do ask. This guide brings together the information you'll find most useful, especially as a new swimming parent.</p>
    <div class="reassure">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
      <span>Don't worry about getting everything right — your coach will guide your swimmer through the day. The most important thing is to take part and enjoy it.</span>
    </div>
  </div>
</section>

<!-- WHAT IS A GALA -->
<section class="what-is">
  <div class="inner">
    <p class="label">What is a Swimming Gala?</p>
    <h2>Simply, a swimming competition</h2>
    <p class="body-text">A swimming gala is the term used for a swimming competition. It gives swimmers the opportunity to put into practice everything they have been working on in training whilst gaining valuable racing experience.</p>
    <p class="body-text">Galas range from small, friendly events aimed at beginners through to National Championships featuring the country's top swimmers. Every competition provides an opportunity for swimmers to develop confidence, improve their skills and achieve personal best times.</p>
    <p class="body-text">Licensed competitions are run under <strong>Swim England rules and regulations</strong> and are divided into four levels:</p>

    <div class="levels-grid">
      {levels.map((l) => (
        <div class="level-card">
          <span class="level-num">Level {l.n}</span>
          <strong>{l.course}</strong>
          <p>{l.text}</p>
        </div>
      ))}
    </div>

    <div class="club-note">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <span>Throughout the season, Torquay Leander swimmers regularly compete at Levels 1, 2 and 3, with newer swimmers beginning their competitive journey at Level 4 events.</span>
    </div>
  </div>
</section>

<!-- HEATS & HDW -->
<section class="heats">
  <div class="inner">
    <p class="label">Heats &amp; Heat Declared Winners</p>
    <h2>How events are decided</h2>
    <p class="body-text">Most swimming events have more competitors than there are lanes in the pool, so races are split into <strong>heats</strong> — each heat is simply a separate race within the same event. Swimmers are normally seeded into heats based on their entry times, with the slower swimmers competing in the earlier heats and the fastest swimmers in the final heats. This helps ensure swimmers race against others of a similar standard.</p>
    <p class="body-text">At many competitions, particularly Level 3 and Level 4 meets, the results are decided using <strong>Heat Declared Winners (HDW)</strong>. This means there is <strong>no final</strong> — every swimmer races once, and when all the heats have finished, the times are combined and ranked.</p>

    <div class="example-box">
      <strong>Example</strong>
      <p>If 40 swimmers enter the 100m Freestyle, they may be divided into five heats of eight. A swimmer who wins Heat 2 may not necessarily win the event if swimmers in later heats record faster times. Once every heat has been completed, all times are compared and medals are awarded to the fastest swimmers in each age group.</p>
    </div>

    <p class="body-text">At higher-level competitions, such as County, Regional and National Championships, some events may instead have <strong>heats followed by finals</strong>. Swimmers race in the heats first, and the fastest qualifiers return later in the session (or day) to compete again in the final for medals and championship places.</p>

    <div class="reassure">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      <span>Because of this, swimmers should always focus on swimming their own race and achieving their best possible time, rather than simply trying to win their individual heat.</span>
    </div>
  </div>
</section>

<!-- COURSE LENGTH & TIMES -->
<section class="course">
  <div class="inner">
    <p class="label">Long Course &amp; Short Course</p>
    <h2>Pool lengths and entry times</h2>
    <p class="body-text">Swimming competitions take place in two standard pool lengths, and when a club advertises a gala it will state which one is being used:</p>

    <div class="course-grid">
      <div class="course-card">
        <span class="course-tag">SC</span>
        <strong>Short Course</strong>
        <span class="course-len">25-metre pool</span>
        <p>Swimmers are often slightly quicker here — more turns and push-offs from the wall provide extra speed.</p>
      </div>
      <div class="course-card">
        <span class="course-tag">LC</span>
        <strong>Long Course</strong>
        <span class="course-len">50-metre pool</span>
        <p>The format used for National, Regional and County championships at Level 1.</p>
      </div>
    </div>

    <h3 class="sub-h">Entry times</h3>
    <p class="body-text">When entering a competition, swimmers are usually asked to provide an <strong>entry time</strong> for each event — their best recorded time for the <strong>full race distance</strong>, not just a single length. For example, a 100m Freestyle Short Course time is the swimmer's best 100m time achieved in a 25m pool, and a 100m Freestyle Long Course time is their best 100m time in a 50m pool.</p>
    <p class="body-text">Entry forms will normally specify whether they require Short Course times, Long Course times, or occasionally state that all entry times should be 25m (Short Course) times. Because Short Course and Long Course times are <strong>not directly comparable</strong>, competitions always specify which type to use.</p>

    <h3 class="sub-h">Time conversions</h3>
    <p class="body-text">Some competitions request Short Course times even though the event will be swum in a Long Course pool — the organisers use them to seed the heats. For higher-level competitions such as Regional and National Championships, swimmers are usually required to submit Long Course qualifying times. If a swimmer has only achieved a qualifying time in a Short Course pool, it may need to be converted using Swim England's approved conversion system before entry.</p>
  </div>
</section>

<!-- RACE RULES (existing) -->
<section class="rules">
  <div class="inner">
    <p class="label">Race Rules</p>
    <h2>How a swimming race works</h2>
    <p class="body-text">A referee initiates each swim heat and the final race, using a series of short blasts on a whistle to signal to swimmers. Races follow the Swim England (ASA) rules and regulations, which govern how each swimmer must start, turn and finish.</p>
  </div>
</section>

<section class="start">
  <div class="inner">
    <p class="label">Starting a Race</p>
    <div class="start-grid">
      {startSteps.map((s) => (
        <div class="start-card">
          <div class="start-num">{s.n}</div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="strokes">
  <div class="inner">
    <p class="label">Strokes, Turns &amp; Finishes</p>
    <h2>The four competitive strokes</h2>
    <p class="body-text">There are four swimming styles recognised in competition. "Stroke" refers to how the swimmer performs the style — and each has its own rules for how to turn at the end of a lap and how to finish the race.</p>
    <div class="stroke-grid">
      {strokes.map((s) => (
        <div class="stroke-card">
          <span class="stroke-icon">{s.icon}</span>
          <strong>{s.name}</strong>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ROLES -->
<section class="roles">
  <div class="inner">
    <p class="label">Roles at a Gala</p>
    <h2>The people who make it happen</h2>
    <p class="body-text">Swimming competitions rely almost entirely on volunteers. Many of the people you'll see around the pool are current or former swimming parents who generously give their time to help the sport run smoothly.</p>
    <div class="volunteer-note">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.42 4.58a5.4 5.4 0 0 0-7.65 0l-.77.78-.77-.78a5.4 5.4 0 0 0-7.65 0C1.46 6.7 1.33 10.28 4 13l8 8 8-8c2.67-2.72 2.54-6.3.42-8.42z"/></svg>
      <span>If any of these roles interest you, we'd love to hear from you — we're always looking for new volunteers.</span>
    </div>

    <div class="tm-card">
      <div class="tm-head">
        <span class="tm-icon">{teamManager.icon}</span>
        <div class="tm-title">
          <span class="tm-chip">The key volunteer role</span>
          <strong>{teamManager.name}</strong>
        </div>
      </div>
      <p class="tm-text">{teamManager.text}</p>
      <ul class="tm-duties">
        {teamManager.duties.map((d) => (
          <li><span class="tm-check">✓</span><span>{d}</span></li>
        ))}
      </ul>
      <p class="tm-footer">{teamManager.footer}</p>
    </div>

    <div class="roles-grid">
      {roles.map((r) => (
        <div class="role-card">
          <span class="role-icon">{r.icon}</span>
          <strong>{r.name}</strong>
          <p>{r.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- WHAT TO BRING -->
<section class="bring">
  <div class="inner">
    <p class="label">What Should Swimmers Bring?</p>
    <h2>The gala kit list</h2>
    <p class="body-text">Every gala is different, but we recommend bringing the following:</p>
    <ul class="kit-list">
      {kit.map((k) => (
        <li>
          <span class="kit-emoji">{k.emoji}</span>
          <span>{k.text}</span>
        </li>
      ))}
    </ul>
    <p class="body-text small-note">Any additional equipment required for a specific competition will be communicated before the event.</p>
  </div>
</section>

<!-- WHAT HAPPENS -->
<section class="day">
  <div class="inner">
    <p class="label">What Happens at a Gala?</p>
    <h2>A typical competition day</h2>
    <p class="body-text">Although every competition is slightly different, the general routine is very similar.</p>
    <div class="day-list">
      {galaDay.map((step, i) => (
        <div class="day-step">
          <div class="day-num">{i + 1}</div>
          <div class="day-body">
            <strong>{step.title}</strong>
            <p>{step.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- MEDALS + FINAL WORD -->
<section class="medals">
  <div class="inner medals-grid">
    <div class="medal-card">
      <span class="medal-emoji">🏅</span>
      <h3>Medals and awards</h3>
      <p>At most competitions there isn't enough time to hold formal presentations during the event, so medals and trophies are usually collected on the day. The main exception is our Club Championships — trophies and medals are presented at our designated awards night, usually in January, where we celebrate the swimmers' achievements.</p>
    </div>
    <div class="medal-card highlight">
      <span class="medal-emoji">❤️</span>
      <h3>A final word</h3>
      <p>Above all, remember that swimming is meant to be enjoyable. Every gala is an opportunity to learn, improve and represent Torquay Leander with pride. Whether it's a swimmer's first competition or a National Championship, we encourage every swimmer to support their teammates, enjoy the experience and celebrate their own progress. Personal bests, good sportsmanship and having fun are every bit as important as winning medals.</p>
    </div>
  </div>
</section>

<!-- HANDY LINKS -->
<section class="links">
  <div class="inner">
    <p class="label">Handy References</p>
    <h2>Useful links for entry forms</h2>
    <div class="links-grid">
      {handyLinks.map((l) => (
        <a class="link-card" href={l.url} target="_blank" rel="noopener noreferrer">
          <strong>{l.name} ↗</strong>
          <span>{l.desc}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CTA (existing) -->
<section class="next">
  <div class="inner next-inner">
    <h2>Ready to race?</h2>
    <p>Our Club Championships are a great first competition — fun, friendly, and held in a familiar pool. Speak to your coach about which events to enter.</p>
    <div class="next-btns">
      <a class="btn-solid" href={`${base}/competitions/club-championships/`}>Club Championships</a>
      <a class="btn-ghost" href={`${base}/competitions/ribbon-gala/`}>Ribbon Gala</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
  .page-hero {
    background: var(--black); padding: 64px 5vw 56px;
    position: relative; overflow: hidden;
  }
  .page-hero::after {
    content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 60px;
    background: #fff; clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .crumb { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.4); font-size: 0.78rem; margin-bottom: 18px; flex-wrap: wrap; }
  .crumb a { color: var(--red); text-decoration: none; }
  .crumb span { opacity: 0.5; }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -1.5px; margin-bottom: 12px; }
  .page-hero p { color: rgba(255,255,255,0.65); font-size: 1rem; max-width: 640px; line-height: 1.7; }

  .inner { max-width: 1100px; margin: 0 auto; }
  .label { font-size: 0.72rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--red); margin-bottom: 14px; }
  h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; letter-spacing: -0.5px; margin-bottom: 14px; }
  .sub-h { font-size: 1.1rem; font-weight: 800; color: var(--text); margin: 28px 0 10px; }
  .body-text { color: var(--muted); font-size: 1rem; line-height: 1.8; max-width: 820px; margin-bottom: 16px; }
  .body-text strong { color: var(--text); }
  .small-note { font-size: 0.88rem; margin-top: 18px; }

  .intro { background: #fff; padding: 72px 5vw 48px; }
  .intro-inner { max-width: 820px; }
  .intro-text { color: var(--muted); font-size: 1.02rem; line-height: 1.85; margin-bottom: 24px; }
  .reassure {
    display: flex; align-items: flex-start; gap: 12px;
    background: var(--red-light); border: 1.5px solid #fecaca; border-radius: 12px;
    padding: 18px 22px; color: var(--text); font-size: 0.92rem; line-height: 1.65;
    max-width: 820px;
  }
  .reassure svg { flex-shrink: 0; margin-top: 2px; color: var(--red); }

  .what-is { background: #fff; padding: 24px 5vw 64px; }
  .levels-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 28px 0; }
  .level-card { background: #f8fafc; border: 1.5px solid var(--border); border-radius: 14px; padding: 22px 20px; }
  .level-card:hover { border-color: var(--red); }
  .level-num { display: inline-block; background: var(--red); color: #fff; border-radius: 8px; padding: 4px 12px; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 12px; }
  .level-card strong { display: block; font-size: 0.92rem; font-weight: 800; color: var(--text); margin-bottom: 6px; }
  .level-card p { color: var(--muted); font-size: 0.82rem; line-height: 1.6; margin: 0; }
  .club-note {
    display: flex; align-items: flex-start; gap: 12px;
    background: #f8fafc; border: 1.5px solid var(--border); border-radius: 12px;
    padding: 18px 22px; color: var(--text); font-size: 0.92rem; line-height: 1.65; max-width: 820px;
  }
  .club-note svg { flex-shrink: 0; margin-top: 2px; color: var(--red); }

  .heats { background: #f8fafc; padding: 64px 5vw; }
  .example-box {
    background: #fff; border: 1.5px solid var(--border); border-left: 4px solid var(--red);
    border-radius: 12px; padding: 20px 24px; margin: 22px 0; max-width: 820px;
  }
  .example-box strong { display: block; font-size: 0.78rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--red); margin-bottom: 8px; }
  .example-box p { color: var(--muted); font-size: 0.92rem; line-height: 1.7; margin: 0; }
  .heats .reassure { margin-top: 22px; background: #fff; }

  .course { background: #fff; padding: 64px 5vw; }
  .course-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 24px 0 8px; max-width: 820px; }
  .course-card { background: #f8fafc; border: 1.5px solid var(--border); border-radius: 14px; padding: 22px 20px; }
  .course-tag { display: inline-block; background: var(--black); color: #fff; border-radius: 8px; padding: 4px 12px; font-size: 0.75rem; font-weight: 800; letter-spacing: 1px; margin-bottom: 12px; }
  .course-card strong { display: block; font-size: 0.95rem; font-weight: 800; color: var(--text); margin-bottom: 2px; }
