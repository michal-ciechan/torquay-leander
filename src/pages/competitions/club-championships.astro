---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadTrophies } from '../../data/trophies.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Events still needing a trophy, read from the club's sheet at build time.
const trophies = await loadTrophies();
// Alpine state for the filterable list. Items are rendered server-side; Alpine only
// hides the ones that don't match, so the list still reads fine without JS.
const trophyState = `{
  items: ${JSON.stringify(trophies.needed.map(({ age, gender, strokeKey, note }) => ({ age, gender, strokeKey, note })))},
  age: 'All', gender: 'All', stroke: 'All', copied: null,
  visible(i) {
    const e = this.items[i];
    return (this.age === 'All' || e.age === this.age)
      && (this.gender === 'All' || e.gender === this.gender)
      && (this.stroke === 'All' || e.strokeKey === this.stroke);
  },
  get shown() { return this.items.filter((_, i) => this.visible(i)); },
  get ageDone() { return this.age !== 'All' && !this.items.some((e) => e.age === this.age); },
  copy(i) {
    navigator.clipboard?.writeText(this.items[i].note);
    this.copied = i;
    setTimeout(() => { if (this.copied === i) this.copied = null; }, 2000);
  },
}`;

// 2026 programme (club poster, Nov 2026), timeline layout. Heat sheet links
// removed for now — they come back nearer the time once the sheets exist.
const days = [
  {
    date: 'Thursday 5th Nov', num: 5, time: '7–9pm',
    sessions: [{ events: ['400m Freestyle (10 & over)'] }],
  },
  {
    date: 'Monday 9th Nov', num: 9, time: '6–10pm',
    note: 'We hope to finish earlier — younger swimmers will race first.',
    // Add `live` to any day once there's a watch-live option; href is the section to jump to.
    live: { label: 'Watch live', href: '#the-cove' },
    sessions: [{ events: ['100m Individual Medley', '25m Backstroke (7 & under)', '200m Breaststroke', '50m Backstroke', '100m Freestyle'] }],
  },
  {
    date: 'Sunday 15th Nov', num: 15, time: '2–7pm',
    note: 'An extended gala, booked to reduce disruption to training.',
    sessions: [
      { label: 'Session 1', events: ['25m Butterfly (7 & under)', '50m Butterfly', '100m Backstroke', '200m Freestyle'] },
      { label: 'Session 2', events: ['25m Breaststroke (7 & under)', '50m Freestyle', '200m Breaststroke'] },
    ],
  },
  {
    date: 'Thursday 19th Nov', num: 19, time: '6–9pm',
    sessions: [{ events: ['200m Individual Medley', '25m Freestyle (7 & under)', '50m Breaststroke', '200m Backstroke', '100m Butterfly'] }],
  },
];

// Unlicensed (longer-distance) events — times aren't recorded on Swim England.
const unlicensed = [
  { date: 'W/C 5th Oct', event: '400m Individual Medley', detail: 'Coach-selected swimmers only', time: 'During training' },
  { date: 'Mon 12th Oct', event: '800m Freestyle (12 & over)', detail: 'See entry conditions below', time: '7:30–9pm' },
  { date: 'Thu 22nd Oct', event: '1500m Freestyle (12 & over)', detail: 'See entry conditions below', time: '7:30–9pm' },
  { date: 'W/C 23rd Nov', event: '200m Butterfly', detail: 'Coach-selected swimmers only', time: 'During training' },
];

// Trophy sponsorship payment links (SumUp, from the club's Nov 2026 poster).
const sponsorOptions = [
  { name: 'Cup', price: 75, icon: '🏆', href: 'https://pay.sumup.com/b2c/QYRLOBRM', style: 'red',
    detail: 'Presented year after year, and extra bases can be added to the cup over time.' },
  { name: 'Shield', price: 50, icon: '🛡️', href: 'https://pay.sumup.com/b2c/QANW2WIL', style: 'dark',
    detail: '18 winner plaques, so 18 years of use, and more can be added after that.' },
];

const ageGroups =['7 years &amp; under', '8–9 years', '10–11 years', '12–13 years', '14–15 years', '16 years &amp; over'];
---
<BaseLayout title="Club Championships — Torquay Leander">

<section class="page-hero">
  <div class="hero-inner">
    <div class="crumb">
      <a href={`${base}/`}>Home</a>
      <span>›</span>
      <a href={`${base}/competitions/`}>Competitions</a>
      <span>›</span>
      <span>Club Championships</span>
    </div>
    <h1>Club Championships</h1>
    <p>Torquay Leander's internal championship meet — open to all club members and a great way to race in a friendly, familiar environment.</p>
  </div>
</section>

<section class="intro">
  <div class="inner intro-inner">
    <p class="label">About the Championships</p>
    <p class="intro-text">Each year Torquay Leander holds its Annual Club Championships as a <strong>licensed competition</strong>. This is great news for our swimmers: every time achieved is treated as official, and can be used for entry into other licensed meets and for Swim England (ASA) rankings. The licensed races take place across a series of evenings, with some longer-distance unlicensed races held at other times.</p>
    <p class="intro-text">All Torquay Leander swimmers are capable of entering a race or two. The championships are fun and a great way to get to know other swimmers in the club. <strong>Speak to your coach if you're unsure what to enter</strong> — and if it's your first gala, take a look at our competition guide.</p>
    <a class="guide-link" href={`${base}/competitions/competition-guide/`}>
      Read the competition guide
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>

<section class="format">
  <div class="inner">
    <p class="label">Format &amp; Age Groups</p>
    <div class="format-grid">
      <div class="format-card">
        <h3>Age groups</h3>
        <p class="fc-sub">Age groups are based on the swimmer's age on 31st December.</p>
        <div class="age-chips">
          {ageGroups.map((a) => <span class="age-chip" set:html={a} />)}
        </div>
      </div>
      <div class="format-card">
        <h3>Longer-distance races</h3>
        <p class="fc-sub">Held as unlicensed events at separate times — dates are in the programme below.</p>
        <ul class="ld-list">
          {unlicensed.map((u) => <li>{u.event}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="programme">
  <div class="inner">
    <p class="label">Programme</p>
    <h2>2026 Club Championships</h2>
    <p class="prog-text">Most championship events take place during normal training times, so the usual swim sessions will not run while a Club Championship event is taking place. Sunday 15th November has been booked as an extended 2pm–7pm gala to reduce disruption. Heat sheets will be published here nearer the time — keep an eye on our Facebook page for announcements.</p>
    <p class="prog-text entry-note"><strong>All members of Torquay Leander can enter.</strong> Please speak to a coach if you're unsure what races to enter your swimmer in. Enter via <a href="https://www.cluborganiser.co.uk/login.php" target="_blank" rel="noopener">Club Organiser</a>.</p>

    <h3 class="prog-sub">Licensed events <span class="prog-sub-note">Times are recorded on Swim England</span></h3>
    <div class="timeline">
      {days.map((d) => (
        <div class="tl-item">
          <div class="tl-node">
            <span class="tl-day">{d.num}</span>
            <span class="tl-mon">Nov</span>
          </div>
          <div class={`tl-cards ${d.sessions.length > 1 ? 'two' : ''}`}>
            {d.sessions.map((sess) => (
              <div class="tl-card">
                <div class="tl-head">
                  <strong>{d.date}</strong>
                  {sess.label && <span class="prog-session">{sess.label}</span>}
                  {sess === d.sessions[0] && <span class="prog-time">{d.time}</span>}
                  {sess === d.sessions[0] && d.live && <a class="live-badge" href={d.live.href}><span class="live-dot"></span>{d.live.label}</a>}
                </div>
                <div class="prog-events">
                  {sess.events.map((e) => <span class="event-tag">{e}</span>)}
                </div>
              </div>
            ))}
            {d.note && <p class="tl-note">{d.note}</p>}
          </div>
        </div>
      ))}
    </div>

    <div class="cove" id="the-cove">
      <strong>📺 Monday 9th Nov — watch live in The Cove!</strong>
      <p>Upstairs at Plainmoor Football Club — double doors immediately behind the pool. Bar snacks and pizza slices are available in The Cove during the evening.</p>
      <ul>
        <li>Visit the pool for your swimmer's heat.</li>
        <li>Use the marked floor area to watch your swimmer.</li>
        <li>After their heat, head back to The Cove so the next family can cheer!</li>
      </ul>
    </div>

    <h3 class="prog-sub unl">Unlicensed events <span class="prog-sub-note">Longer-distance races</span></h3>
    <div class="unl-grid">
      {unlicensed.map((u) => (
        <div class="tl-card">
          <div class="tl-head"><strong>{u.date}</strong><span class="prog-time">{u.time}</span></div>
          <div class="prog-events"><span class="event-tag">{u.event}</span></div>
          <p class="unl-detail">{u.detail}</p>
        </div>
      ))}
    </div>
    <p class="prog-text entry-note"><strong>800m &amp; 1500m entry conditions:</strong> entries to the 800m and 1500m Freestyle are limited, and may be made at the coaches' discretion.</p>
  </div>
</section>

<section class="faq">
  <div class="inner">
    <p class="label">On the Day</p>
    <div class="faq-grid">
      <div class="faq-card">
        <span class="faq-icon">⏰</span>
        <h3>Arrive in good time</h3>
        <p>Please arrive approximately 15 minutes before the session warm-up time so swimmers are ready to go.</p>
      </div>
      <div class="faq-card">
        <span class="faq-icon">🍫</span>
        <h3>Tuck shop</h3>
        <p>A tuck shop runs during all sessions, selling snacks, juice and water.</p>
      </div>
      <div class="faq-card">
        <span class="faq-icon">🎟️</span>
        <h3>50/50 raffle</h3>
        <p>We run a 50/50 raffle — half the proceeds go into the prize pot, and half towards the cost of running the championships.</p>
      </div>
      <div class="faq-card">
        <span class="faq-icon">📖</span>
        <h3>First gala?</h3>
        <p>If this is your first gala, our <a href={`${base}/competitions/competition-guide/`}>competition guide</a> walks you through what to expect.</p>
      </div>
    </div>
  </div>
</section>

<section class="extras">
  <div class="inner extras-grid">
    <div class="extra-card">
      <h3>Devon Championship qualifying times</h3>
      <p>The Devon Championship qualifying times are set annually by Devon County ASA. These "County Times" are required for entry into the Devon County Championships, typically held at the Plymouth Life Centre.</p>
      <a class="extra-link" href={`${base}/competitions/devon-times/`}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M5 3 2 6"/><path d="m22 6-3-3"/></svg>
        2027 Devon qualifying times
      </a>
    </div>
    <div class="extra-card highlight">
      <span class="extra-emoji">🎉</span>
      <h3>Presentation night</h3>
      <p><strong>Friday 15th January 2027 at Arena Torquay — all welcome!</strong> Our annual awards night is great fun with food and a disco, and a chance to celebrate all of our fantastic young swimmers. Trophies and medals won at the club championships are awarded on the evening.</p>
      <a class="extra-link on-red" href="#sponsor-a-trophy">Sponsor a trophy →</a>
    </div>
  </div>
</section>

<!-- Trophy sponsorship (club poster, Nov 2026). Payment goes through the club's SumUp
     links. The events list comes from the club's OneDrive sheet at build time
     (src/data/trophies.mjs), refreshed by the daily scheduled deploy. -->
<section class="sponsor" id="sponsor-a-trophy">
  <div class="inner">
    <p class="label">Trophy Sponsorship</p>
    <h2>Sponsor a trophy</h2>
    <p class="sponsor-text">A number of our Club Championship events don't yet have trophies for the winners. Help us recognise and celebrate our swimmers' achievements by sponsoring one.</p>
    <p class="sponsor-text">It's a <strong>one-off payment</strong> that buys a trophy for the club. Our cups and shields are <strong>perpetual awards</strong>, presented to the winner of that event year after year, and <strong>your family or business name is added to the trophy</strong> as its sponsor. 🏆</p>

    <div class="sponsor-grid">
      {sponsorOptions.map((o) => (
        <div class="sponsor-card">
          <span class="sponsor-icon">{o.icon}</span>
          <h3>Sponsor a {o.name}</h3>
          <p class="sponsor-price">£{o.price}</p>
          <p class="sponsor-detail">{o.detail}</p>
          <a class:list={['sponsor-btn', o.style]} href={o.href} target="_blank" rel="noopener">Sponsor a {o.name.toLowerCase()}</a>
        </div>
      ))}
    </div>

    <div class="sponsor-note">
      <span aria-hidden="true">📝</span>
      <p><strong>Please add the event you wish to sponsor in the note section when you pay</strong> — for example: <em>10–11 F, 200 Backstroke</em>.</p>
    </div>

    <div class="needs" id="events-needing-trophies" x-data={trophyState}>
      <div class="needs-head">
        <h3>Events still needing a trophy</h3>
        <p class="needs-count" aria-live="polite"><strong x-text="shown.length">{trophies.needed.length}</strong> <span x-text="shown.length === 1 ? 'event' : 'events'">events</span></p>
      </div>

      <div class="filters">
        <div class="filter-row" role="group" aria-label="Age group">
          <span class="filter-label">Age</span>
          {['All', ...trophies.ages].map((a) => (
            <button type="button" class="chip" :class={`{ on: age === ${JSON.stringify(a)} }`} :aria-pressed={`age === ${JSON.stringify(a)}`} @click={`age = ${JSON.stringify(a)}`}>{a}</button>
          ))}
        </div>
        <div class="filter-row" role="group" aria-label="Male or female">
          <span class="filter-label">Gender</span>
          {['All', 'Male', 'Female'].map((g) => (
            <button type="button" class="chip" :class={`{ on: gender === '${g}' }`} :aria-pressed={`gender === '${g}'`} @click={`gender = '${g}'`}>{g}</button>
          ))}
        </div>
        <div class="filter-row" role="group" aria-label="Stroke">
          <span class="filter-label">Stroke</span>
          {['All', ...trophies.strokes].map((s) => (
            <button type="button" class="chip" :class={`{ on: stroke === '${s}' }`} :aria-pressed={`stroke === '${s}'`} @click={`stroke = '${s}'`}>{s}</button>
          ))}
        </div>
      </div>

      <ul class="needs-list">
        {trophies.needed.map((e, i) => (
          <li class="need" x-show={`visible(${i})`}>
            <div class="need-main">
              <strong>{e.distance}m {e.stroke}</strong>
              <span>{e.age} · {e.gender}</span>
            </div>
            <button type="button" class="need-copy" @click={`copy(${i})`} title="Copy the payment note for this event">
              <span x-text={`copied === ${i} ? 'Copied ✓' : 'Copy note'`}>Copy note</span>
            </button>
          </li>
        ))}
      </ul>
      <p class="needs-empty" x-show="ageDone" x-cloak>🏆 No trophies left to sponsor for <span x-text="age"></span> — every event in this age group already has one. Thank you to our sponsors!</p>
      <p class="needs-empty" x-show="shown.length === 0 && !ageDone" x-cloak>No events match those filters — try another age group or stroke.</p>
      <p class="needs-foot">Found one? Use <strong>Copy note</strong> and paste it into the note when you pay with the Cup or Shield button above.</p>
      {trophies.sponsored.length > 0 && (
        <p class="needs-thanks">🏆 Thank you to our latest trophy sponsors: {trophies.sponsored.join(', ')}.</p>
      )}
    </div>

    <div class="sponsor-ask">
      <div>
        <h3>Any questions?</h3>
        <p>Not sure which trophy to choose, or want to sponsor more than one? Send us a message and a member of the committee will get back to you.</p>
      </div>
      <form data-enquiry="general">
        <input type="hidden" name="subject" value="Trophy sponsorship" />
        <input class="form-field" type="text" name="name" placeholder="Your name" aria-label="Your name" required />
        <input class="form-field" type="email" name="email" placeholder="Email address" aria-label="Email address" required />
        <textarea class="form-field" name="message" placeholder="Your question" aria-label="Your question" required></textarea>
        <div class="form-trap" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
        <button class="form-submit" type="submit">Send</button>
      </form>
    </div>
  </div>
</section>

</BaseLayout>

<style>
  .page-hero {
    background: var(--black); padding: 64px 5vw 56px;
    position: relative; overflow: hidden;
  }
  .page-hero::after {
    content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 60px;
    background: #fff; clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .crumb { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.4); font-size: 0.78rem; margin-bottom: 18px; flex-wrap: wrap; }
  .crumb a { color: var(--red); text-decoration: none; }
  .crumb span { opacity: 0.5; }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -1.5px; margin-bottom: 12px; }
  .page-hero p { color: rgba(255,255,255,0.65); font-size: 1rem; max-width: 600px; line-height: 1.7; }

  .inner { max-width: 1100px; margin: 0 auto; }
  .label { font-size: 0.72rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--red); margin-bottom: 14px; }

  .intro { background: #fff; padding: 72px 5vw 56px; }
  .intro-inner { max-width: 820px; }
  .intro-text { color: var(--muted); font-size: 1.02rem; line-height: 1.85; margin-bottom: 18px; }
  .intro-text strong { color: var(--text); }
  .guide-link { display: inline-flex; align-items: center; gap: 8px; color: var(--red); font-weight: 700; font-size: 0.92rem; text-decoration: none; margin-top: 6px; }
  .guide-link:hover { text-decoration: underline; }

  .format { background: #f8fafc; padding: 64px 5vw; }
  .format-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .format-card { background: #fff; border: 1.5px solid var(--border); border-radius: 16px; padding: 28px 26px; }
  .format-card h3 { font-size: 1.05rem; font-weight: 800; color: var(--text); margin-bottom: 6px; }
  .fc-sub { color: var(--muted); font-size: 0.86rem; line-height: 1.6; margin-bottom: 18px; }
  .age-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .age-chip { background: var(--red-light); color: var(--red-dark); border-radius: 999px; padding: 7px 14px; font-size: 0.82rem; font-weight: 700; }
  .ld-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .ld-list li { padding-left: 20px; position: relative; color: var(--text); font-size: 0.9rem; font-weight: 600; }
  .ld-list li::before { content: ''; position: absolute; left: 0; top: 7px; width: 8px; height: 8px; border-radius: 50%; background: var(--red); }

  .programme { background: #fff; padding: 64px 5vw; }
  .programme h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; letter-spacing: -0.5px; margin-bottom: 12px; }
  .prog-text { color: var(--muted); font-size: 0.97rem; line-height: 1.75; max-width: 760px; margin-bottom: 32px; }
  .timeline { position: relative; }
  .timeline::before {
    content: ''; position: absolute; left: 27px; top: 10px; bottom: 10px;
    width: 3px; background: linear-gradient(var(--red), var(--red-dark)); border-radius: 2px;
  }
  .tl-item { position: relative; display: flex; gap: 22px; padding: 12px 0; }
  .tl-node {
    position: relative; z-index: 1; flex-shrink: 0;
    width: 58px; height: 58px; border-radius: 16px;
    background: var(--red); color: #fff;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    box-shadow: 0 8px 22px rgba(220,38,38,0.35);
  }
  .tl-day { font-size: 1.25rem; font-weight: 900; line-height: 1; }
  .tl-mon { font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; opacity: 0.85; }
  .tl-cards { flex: 1; display: grid; gap: 14px; min-width: 0; }
  .tl-cards.two { grid-template-columns: 1fr 1fr; }
  .tl-card { background: #fff; border: 1.5px solid var(--border); border-radius: 14px; padding: 18px 22px; }
  .tl-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
  .tl-head strong { font-size: 0.98rem; font-weight: 800; color: var(--text); }
  .prog-session { background: var(--red-light); color: var(--red-dark); border-radius: 999px; padding: 5px 13px; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; }
  .prog-events { display: flex; flex-wrap: wrap; gap: 8px; }
  .prog-sub { font-size: 1.1rem; font-weight: 800; margin: 8px 0 18px; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .prog-sub.unl { margin-top: 44px; }
  .prog-sub-note { font-size: 0.78rem; font-weight: 600; color: var(--muted); }
  .entry-note { margin-top: 28px; margin-bottom: 8px; }
  .prog-time { background: #f1f5f9; border: 1px solid var(--border); border-radius: 999px; padding: 4px 12px; font-size: 0.78rem; font-weight: 700; color: var(--text); }
  .tl-note { color: var(--muted); font-size: 0.85rem; margin: 0; }
  .live-badge { display: inline-flex; align-items: center; gap: 7px; background: var(--red); color: #fff; border-radius: 999px; padding: 4px 12px; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; text-decoration: none; }
  .live-badge:hover { background: var(--red-dark); }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #fff; animation: live-pulse 1.6s ease-in-out infinite; }
  @keyframes live-pulse { 50% { opacity: 0.3; } }
  @media (prefers-reduced-motion: reduce) { .live-dot { animation: none; } }
  .cove { margin-top: 32px; scroll-margin-top: 90px; background: var(--red-light); border: 1.5px solid var(--red); border-radius: 14px; padding: 18px 22px; }
  .cove strong { color: var(--red-dark); font-size: 1rem; font-weight: 800; }
  .cove p { color: var(--text); font-size: 0.9rem; line-height: 1.6; margin: 6px 0 10px; }
  .cove ul { list-style: disc; margin: 0; padding-left: 20px; color: var(--text); font-size: 0.88rem; line-height: 1.7; }
  .unl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .unl-detail { color: var(--muted); font-size: 0.82rem; margin: 10px 0 0; }
  .event-tag { background: #f1f5f9; border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px; font-size: 0.8rem; font-weight: 600; color: var(--text); }

  .faq { background: #f8fafc; padding: 64px 5vw; }
  .faq-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
