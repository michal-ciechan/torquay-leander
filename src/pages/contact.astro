---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Contact Us — Torquay Leander">

<section class="page-hero">
  <div class="hero-inner">
    <div class="crumb">
      <a href={`${base}/`}>Home</a>
      <span>›</span>
      <span>Contact</span>
    </div>
    <h1>Contact Us</h1>
    <p>Get in touch with Torquay Leander Swimming Club — whether you're interested in joining, have a question about training, or just want to say hello.</p>
  </div>
</section>

<section class="join" id="contact">
  <div class="join-inner">
    <div class="join-head">
      <p class="section-label">Get in Touch</p>
      <p class="section-intro" style="margin:12px auto 0;">Whether your goal is to improve fitness, compete at a higher level, or simply enjoy swimming as part of a great community, Torquay Leander Swimming Club welcomes you.</p>
      <p class="join-sub-intro">We are always excited to hear from new swimmers and families interested in becoming part of the club.</p>
    </div>
    <div class="join-grid">
      <div class="join-card join-form-card" x-data="{ tab: initialTab() }">
        <div class="enq-tabs" role="tablist">
          <button class="enq-tab" :class="{ active: tab === 'membership' }" @click="tab = 'membership'" role="tab">Membership</button>
          <button class="enq-tab" :class="{ active: tab === 'general' }" @click="tab = 'general'" role="tab">General enquiry</button>
        </div>

        <template x-if="tab === 'membership'">
          <div>
            <h3>Ready to Dive In?</h3>
            <p class="join-form-intro">Interested in coming for a free trial? Please register your interest below. We understand it's not just about your ability but also the environment you train in — feeling comfortable with your fellow swimmers, coaches and surroundings is the best way to reach your potential.</p>
            <input class="form-field" type="text" placeholder="Name of Swimmer" />
            <label class="form-field-label" for="dob">Date of Birth</label>
            <input id="dob" class="form-field form-field-date" type="date" />
            <input class="form-field" type="text" placeholder="Swim level of swimmer (Stage 5 minimum)" />
            <input class="form-field" type="text" placeholder="Name of parent / guardian" />
            <input class="form-field" type="tel" placeholder="Contact number" />
            <input class="form-field" type="email" placeholder="Email address" />
            <button class="form-submit" onclick="window.location='mailto:torquayleander@hotmail.com?subject=Membership%20enquiry'">Send My Interest</button>
          </div>
        </template>

        <template x-if="tab === 'general'">
          <div>
            <h3>Get in Touch</h3>
            <p class="join-form-intro">Any other question — training times, galas, volunteering, or anything else about the club — send it over and a member of the committee will get back to you.</p>
            <input class="form-field" type="text" placeholder="Your name" />
            <input class="form-field" type="email" placeholder="Email address" />
            <input class="form-field" type="tel" placeholder="Contact number (optional)" />
            <input class="form-field" type="text" placeholder="Subject" />
            <textarea class="form-field" placeholder="How can we help?"></textarea>
            <button class="form-submit" onclick="window.location='mailto:torquayleander@hotmail.com?subject=General%20enquiry'">Send Enquiry</button>
          </div>
        </template>
      </div>
      <div class="join-card join-map-card">
        <div class="join-map-embed">
          <div id="join-map"></div>
        </div>
        <div class="join-map-foot">
          <strong>Swim Torquay — Plainmoor</strong>
          <p>We train at Swim Torquay in the Plainmoor area of Torquay, Devon. Parking and spectator access available on session nights.</p>
          <a href="https://www.google.com/maps?q=Swim+Torquay+Plainmoor" target="_blank" rel="noopener">Open in Google Maps →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Deep links from the home page: /contact/?enquiry=general opens that tab.
  function initialTab() {
    return new URLSearchParams(location.search).get('enquiry') === 'general' ? 'general' : 'membership';
  }
  function initJoinMap() {
    const location = { lat: 50.475731, lng: -3.524576 }; // Swim Torquay, Marnham Rd, Plainmoor, TQ1 3QP
    const map = new google.maps.Map(document.getElementById('join-map'), {
      center: location,
      zoom: 16,
      zoomControl: true,
      mapTypeControl: false,
      streetViewControl: true,
      fullscreenControl: true,
    });
    new google.maps.Marker({ position: location, map, title: 'Swim Torquay — Plainmoor' });
  }
</script>
<script is:inline async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCFulZw8ODr_AwZv7qCFLTqvPEryJrCbuw&loading=async&callback=initJoinMap"></script>

</BaseLayout>

<style>
  .page-hero {
    background: var(--black); padding: 64px 5vw 56px;
    position: relative; overflow: hidden;
  }
  .page-hero::after {
    content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 60px;
    background: var(--red-light); clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .crumb { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.4); font-size: 0.78rem; margin-bottom: 18px; flex-wrap: wrap; }
  .crumb a { color: var(--red); text-decoration: none; }
  .crumb span { opacity: 0.5; }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -1.5px; margin-bottom: 12px; }
  .page-hero p { color: rgba(255,255,255,0.65); font-size: 1rem; max-width: 620px; line-height: 1.7; }
</style>
