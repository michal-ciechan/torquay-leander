---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadShop, SHOP_URL } from '../../data/wyvern-shop.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = await loadShop();
const gbp = (n: number) => `£${n.toFixed(2)}`;
---
<BaseLayout title="Merchandise — Torquay Leander">

<section class="page-hero">
  <div class="hero-inner">
    <div class="crumb">
      <a href={`${base}/`}>Home</a>
      <span>›</span>
      <span>Merchandise</span>
    </div>
    <h1>Merchandise</h1>
    <p>Club swimwear, training kit and leisurewear in Torquay Leander colours, sold through our official club shop with Wyvern Swimwear.</p>
    <a class="btn-primary shop-all" href={SHOP_URL} target="_blank" rel="noopener">Shop all club kit on Wyvern →</a>
  </div>
</section>

<section class="shop">
  <div class="shop-inner">
    <p class="shop-note">Choose an item to pick your size and order on Wyvern Swimwear's site. Sizing, payment and delivery are all handled by Wyvern.</p>
    {groups.map((g) => (
      <div class="shop-group" id={g.key}>
        <h2>{g.label}</h2>
        <p class="shop-strap">{g.strap}</p>
        <div class="shop-grid">
          {g.items.map((p) => (
            <a class="shop-card" href={p.url} target="_blank" rel="noopener">
              <div class="shop-img">{p.image && <img src={p.image} alt={`Torquay Leander ${p.title}`} loading="lazy" />}</div>
              <div class="shop-body">
                <h3>{p.title}</h3>
                <p class="shop-price">{p.priceMax > p.price ? `from ${gbp(p.price)}` : gbp(p.price)}</p>
                <span class="shop-buy">Buy on Wyvern →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
    <div class="shop-foot">
      <a class="btn-primary" href={SHOP_URL} target="_blank" rel="noopener">See the full Torquay Leander collection →</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
  .page-hero {
    background: var(--black); padding: 64px 5vw 56px;
    position: relative; overflow: hidden;
  }
  .page-hero::after {
    content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 60px;
    background: #fafafa; clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .crumb { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.4); font-size: 0.78rem; margin-bottom: 18px; }
  .crumb a { color: var(--red); text-decoration: none; }
  .crumb span { opacity: 0.5; }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -1.5px; margin-bottom: 12px; }
  .page-hero p { color: rgba(255,255,255,0.65); font-size: 1rem; max-width: 560px; line-height: 1.7; }
  .shop-all { display: inline-block; margin-top: 24px; position: relative; z-index: 1; }

  .shop { background: #fafafa; padding: 24px 5vw 80px; }
  .shop-inner { max-width: 1200px; margin: 0 auto; }
  .shop-note { color: var(--muted); font-size: 0.92rem; line-height: 1.6; margin-bottom: 8px; }
  .shop-group { margin-top: 40px; }
  .shop-group h2 { font-size: 1.5rem; font-weight: 900; letter-spacing: -0.5px; color: var(--text); }
  .shop-strap { color: var(--muted); font-size: 0.95rem; margin: 4px 0 18px; }
  .shop-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
  .shop-card {
    display: flex; flex-direction: column; background: #fff;
    border: 1.5px solid var(--border); border-radius: 14px; overflow: hidden;
    text-decoration: none; color: var(--text); transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .shop-card:hover { transform: translateY(-3px); border-color: var(--red); box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
  .shop-img { aspect-ratio: 1; background: #fff; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--border); }
  .shop-img img { width: 100%; height: 100%; object-fit: contain; }
  .shop-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .shop-body h3 { font-size: 1rem; font-weight: 800; line-height: 1.3; }
  .shop-price { color: var(--muted); font-size: 0.9rem; }
  .shop-buy { margin-top: auto; padding-top: 10px; color: var(--red); font-weight: 700; font-size: 0.88rem; }
  .shop-foot { text-align: center; margin-top: 48px; }
  .shop-foot .btn-primary { display: inline-block; }
  @media (max-width: 560px) {
    .shop-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
    .shop-body { padding: 10px 12px 12px; }
    .shop-body h3 { font-size: 0.88rem; }
    .shop-price, .shop-buy { font-size: 0.8rem; }
  }
</style>
