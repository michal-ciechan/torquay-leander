---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categories } from '../../../data/training-videos.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Training Videos — Torquay Leander">

<section class="page-hero">
  <div class="hero-inner">
    <div class="crumb">
      <a href={`${base}/`}>Home</a>
      <span>›</span>
      <a href={`${base}/training/`}>Training</a>
      <span>›</span>
      <span>Training Videos</span>
    </div>
    <h1>Training Videos</h1>
    <p>A land-training library from Swim England — every session swimmer-specific, most needing nothing beyond floor space. Pick a category to see each video with a full summary of what's in it.</p>
  </div>
</section>

<section class="cat-list">
  <div class="inner">
    <div class="cat-grid">
      {categories.map((cat) => (
        <a class="cat-card" href={`${base}/training/videos/${cat.key}/`}>
          <span class="cat-emoji">{cat.emoji}</span>
          <div class="cat-body">
            <strong>{cat.label}</strong>
            <p>{cat.strap}</p>
            <span class="cat-count">{cat.videos.length} video{cat.videos.length > 1 ? 's' : ''} →</span>
          </div>
          <div class="cat-thumbs">
            {cat.videos.slice(0, 3).map((v) => (
              <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt="" loading="lazy" />
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="guide-band">
  <div class="inner guide-band-inner">
    <div>
      <h2>Training for a first competition?</h2>
      <p>Our Swimming Galas — A Parent's Guide covers everything from entry times to what happens on the day.</p>
    </div>
    <a class="band-btn" href={`${base}/competitions/competition-guide/`}>Read the competition guide →</a>
  </div>
</section>

</BaseLayout>

<style>
  .page-hero {
    background: var(--black); padding: 64px 5vw 56px;
    position: relative; overflow: hidden;
  }
  .page-hero::after {
    content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 60px;
    background: #fff; clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .crumb { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.4); font-size: 0.78rem; margin-bottom: 18px; flex-wrap: wrap; }
  .crumb a { color: var(--red); text-decoration: none; }
  .crumb span { opacity: 0.5; }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -1.5px; margin-bottom: 12px; }
  .page-hero p { color: rgba(255,255,255,0.65); font-size: 1rem; max-width: 660px; line-height: 1.7; }

  .inner { max-width: 1100px; margin: 0 auto; }

  .cat-list { background: #fff; padding: 64px 5vw 72px; }
  .cat-grid { display: flex; flex-direction: column; gap: 18px; }
  .cat-card {
    display: flex; align-items: center; gap: 22px;
    border: 1.5px solid var(--border); border-radius: 18px; padding: 26px 28px;
    text-decoration: none; color: inherit; transition: all 0.2s;
  }
  .cat-card:hover { border-color: var(--red); box-shadow: 0 10px 32px rgba(220,38,38,0.1); transform: translateY(-2px); }
  .cat-emoji { font-size: 2.2rem; flex-shrink: 0; }
  .cat-body { min-width: 0; }
  .cat-body strong { display: block; font-size: 1.15rem; font-weight: 800; color: var(--text); margin-bottom: 4px; }
  .cat-body p { color: var(--muted); font-size: 0.88rem; line-height: 1.6; margin: 0 0 8px; }
  .cat-count { color: var(--red); font-size: 0.85rem; font-weight: 700; }
  .cat-thumbs { display: flex; gap: 8px; margin-left: auto; flex-shrink: 0; }
  .cat-thumbs img { width: 104px; aspect-ratio: 16/9; object-fit: cover; border-radius: 8px; border: 1.5px solid var(--border); }

  .guide-band { background: var(--black); padding: 56px 5vw; }
  .guide-band-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .guide-band h2 { color: #fff; font-size: clamp(1.3rem, 2.5vw, 1.7rem); font-weight: 800; letter-spacing: -0.5px; margin-bottom: 6px; }
  .guide-band p { color: rgba(255,255,255,0.7); font-size: 0.95rem; line-height: 1.6; margin: 0; max-width: 560px; }
  .band-btn {
    flex-shrink: 0; background: var(--red); color: #fff; text-decoration: none;
    padding: 13px 26px; border-radius: 10px; font-weight: 700; font-size: 0.92rem;
    transition: transform 0.2s, background 0.2s;
  }
  .band-btn:hover { background: var(--red-dark); transform: translateY(-2px); }

  @media (max-width: 820px) {
    .cat-thumbs img:nth-child(3) { display: none; }
  }
  @media (max-width: 680px) {
    .cat-thumbs { display: none; }
  }
</style>
