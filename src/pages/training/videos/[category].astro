---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categories } from '../../../data/training-videos.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export function getStaticPaths() {
  return categories.map((cat) => ({ params: { category: cat.key }, props: { cat } }));
}

const { cat } = Astro.props;
const others = categories.filter((c) => c.key !== cat.key);
---
<BaseLayout title={`${cat.label} Videos — Torquay Leander`}>

<section class="page-hero">
  <div class="hero-inner">
    <div class="crumb">
      <a href={`${base}/`}>Home</a>
      <span>›</span>
      <a href={`${base}/training/`}>Training</a>
      <span>›</span>
      <a href={`${base}/training/videos/`}>Training Videos</a>
      <span>›</span>
      <span>{cat.label}</span>
    </div>
    <h1>{cat.emoji} {cat.label}</h1>
    <p>{cat.strap}</p>
  </div>
</section>

{cat.videos.map((v, i) => (
  <section class={`video-block ${i % 2 ? 'flip' : ''}`}>
    <div class="inner vb-grid">
      <div class="vb-media">
        <button class="vid-embed" data-vid={v.id} aria-label={`Play ${v.title}`}>
          <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt={v.title} loading="lazy" />
          <span class="vid-play"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          <span class="vid-duration">{v.duration}</span>
        </button>
      </div>
      <div class="vb-text">
        <h2><span class="vb-emoji">{v.emoji}</span> {v.title} {v.level && <span class="vb-level">{v.level}</span>}</h2>
        <p class="vb-summary">{v.summary}</p>
        <ul class="vb-points">
          {v.points.map((p) => (
            <li><span class="vb-point-emoji">{p.emoji}</span><span>{p.text}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
))}

<section class="more-cats">
  <div class="inner">
    <p class="label">More Training Videos</p>
    <div class="more-row">
      {others.map((c) => (
        <a class="more-pill" href={`${base}/training/videos/${c.key}/`}>{c.emoji} {c.label}</a>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  // Click-to-play: swap the thumbnail for the YouTube iframe on demand.
  document.addEventListener('click', function (e) {
    const btn = e.target.closest('.vid-embed');
    if (!btn) return;
    const id = btn.getAttribute('data-vid');
    const frame = document.createElement('iframe');
    frame.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
    frame.title = btn.getAttribute('aria-label') || 'Video';
    frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    frame.allowFullscreen = true;
    frame.className = 'vid-frame';
    btn.replaceWith(frame);
  });
</script>

</BaseLayout>

<style>
  .page-hero {
    background: var(--black); padding: 64px 5vw 56px;
    position: relative; overflow: hidden;
  }
  .page-hero::after {
    content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 60px;
    background: #fff; clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .crumb { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.4); font-size: 0.78rem; margin-bottom: 18px; flex-wrap: wrap; }
  .crumb a { color: var(--red); text-decoration: none; }
  .crumb span { opacity: 0.5; }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -1.5px; margin-bottom: 12px; }
  .page-hero p { color: rgba(255,255,255,0.65); font-size: 1rem; max-width: 640px; line-height: 1.7; }

  .inner { max-width: 1100px; margin: 0 auto; }
  .label { font-size: 0.72rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--red); margin-bottom: 14px; }

  .video-block { padding: 56px 5vw; background: #fff; }
  .video-block.flip { background: #f8fafc; }
  .vb-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: center; }
  .video-block.flip .vb-media { order: 2; }
  .video-block.flip .vb-text { order: 1; }

  .vb-media .vid-embed {
    position: relative; display: block; width: 100%; aspect-ratio: 16 / 9;
    border: none; padding: 0; cursor: pointer; background: var(--black);
    border-radius: 16px; overflow: hidden;
    box-shadow: 0 16px 44px rgba(0,0,0,0.16);
  }
  .vid-embed img { width: 100%; height: 100%; object-fit: cover; opacity: 0.88; transition: opacity 0.2s, transform 0.3s; }
  .vid-embed:hover img { opacity: 1; transform: scale(1.03); }
  .vid-play {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 60px; height: 60px; border-radius: 50%;
    background: rgba(220,38,38,0.92); color: #fff;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 24px rgba(0,0,0,0.35); transition: transform 0.2s;
  }
  .vid-embed:hover .vid-play { transform: translate(-50%, -50%) scale(1.1); }
  .vid-duration {
    position: absolute; bottom: 12px; right: 12px;
    background: rgba(10,10,10,0.85); color: #fff;
    font-size: 0.74rem; font-weight: 700; border-radius: 6px; padding: 3px 9px;
  }
  :global(.vid-frame) { width: 100%; aspect-ratio: 16 / 9; border: none; display: block; border-radius: 16px; box-shadow: 0 16px 44px rgba(0,0,0,0.16); }

  .vb-text h2 {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    font-size: clamp(1.15rem, 2vw, 1.42rem); font-weight: 800; letter-spacing: -0.4px;
    margin-bottom: 12px;
  }
  .vb-emoji { font-size: 1.5rem; }
  .vb-level { background: var(--red-light); color: var(--red-dark); border-radius: 999px; padding: 3px 12px; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; }
  .vb-summary { color: var(--muted); font-size: 0.95rem; line-height: 1.75; margin-bottom: 18px; }
  .vb-points { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 9px; }
  .vb-points li {
    display: flex; align-items: flex-start; gap: 10px;
    background: #fff; border: 1.5px solid var(--border); border-radius: 10px;
    padding: 10px 14px; font-size: 0.86rem; color: var(--text); font-weight: 600; line-height: 1.5;
  }
  .video-block.flip .vb-points li { background: #fff; }
  .vb-point-emoji { flex-shrink: 0; }

  .more-cats { background: #fff; padding: 48px 5vw 72px; border-top: 1.5px solid var(--border); }
  .more-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .more-pill {
    display: inline-block; text-decoration: none; color: var(--text);
    background: #f1f5f9; border: 1.5px solid var(--border); border-radius: 999px;
    padding: 10px 20px; font-size: 0.88rem; font-weight: 700; transition: all 0.15s;
  }
  .more-pill:hover { border-color: var(--red); color: var(--red); }

  @media (max-width: 820px) {
    .vb-grid { grid-template-columns: 1fr; gap: 24px; }
    .video-block.flip .vb-media { order: 0; }
    .video-block.flip .vb-text { order: 1; }
  }
</style>
