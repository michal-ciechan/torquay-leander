---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notice, upcomingChanges, changeCalendars } from '../../data/session-changes.mjs';
import { squadSessions } from '../../data/training-timetable.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { items: changeItems, groups: changeGroups } = upcomingChanges();
const calendars = changeCalendars();

const coaches = [
  { name: 'Neil', role: 'Head Coach', img: 'https://torquayleander.co.uk/wp-content/uploads/2021/08/Neil-e1628767191779-400x516.jpg' },
  { name: 'Lisa', role: 'Swim Coach', img: `${base}/coaches/lisa.jpg` },
  { name: 'Gerry', role: 'Swim Coach', img: 'https://torquayleander.co.uk/wp-content/uploads/2021/07/Coach-2-2000-x-1600-e1628661652650-400x516.jpg' },
  { name: 'Jon', role: 'Swim Coach', img: 'https://torquayleander.co.uk/wp-content/uploads/2025/01/IMG_0603-400x516.jpg' },
  { name: 'Matt', role: 'Swim Coach', img: 'https://torquayleander.co.uk/wp-content/uploads/2021/07/Poolside-Helper-1-2000-x-1600-e1628763126628-400x516.jpg' },
  { name: 'Becky', role: 'Swim Coach', img: 'https://torquayleander.co.uk/wp-content/uploads/2025/01/IMG_6420-scaled-e1738265017605-400x516.jpg' },
  { name: 'Noemi', role: 'Swim and Dry Land Training Coach', img: `${base}/coaches/noemi.jpg` },
  { name: 'Giles', role: 'Assistant Swim Coach', img: 'https://torquayleander.co.uk/wp-content/uploads/2025/01/IMG_6422-scaled-e1738264896412-400x516.jpg' },
  { name: 'Katie', role: 'Assistant Swim Coach', img: 'https://torquayleander.co.uk/wp-content/uploads/2025/01/IMG_6424-scaled-e1738264824150-400x516.jpg' },
];
---
<BaseLayout title="Training — Torquay Leander Swimming Club">

<!-- HERO -->
<section class="page-hero">
  <div class="hero-inner">
    <div class="crumb">
      <a href={`${base}/`}>Home</a>
      <span>›</span>
      <span>Training</span>
    </div>
    <h1>Training at Torquay Leander</h1>
    <p>Professional qualified coaching for every training session, with a specific annual training plan built around our gala program.</p>
    <div class="hero-pills">
      <span class="pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Professional qualified coaching</span>
      <span class="pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> No minimum training hours</span>
      <span class="pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Free trial session</span>
    </div>
  </div>
</section>

<!-- SUB-PAGES -->
<section class="sub-nav">
  <div class="inner">
    <div class="sub-cards">
      <a class="sub-card" href="#timetable">
        <span class="sub-icon">📅</span>
        <span class="sub-body">
          <strong>Training Timetable</strong>
          <span class="sub-desc">Weekly session times for every squad</span>
        </span>
      </a>
      <a class="sub-card" href="#coaches">
        <span class="sub-icon">🏊</span>
        <span class="sub-body">
          <strong>Our Coaches</strong>
          <span class="sub-desc">Meet our volunteer coaching team</span>
        </span>
      </a>
      <a class="sub-card" href={`${base}/training/equipment/`}>
        <span class="sub-icon">🎒</span>
        <span class="sub-body">
          <strong>Training Equipment</strong>
          <span class="sub-desc">The kit every swimmer needs</span>
        </span>
      </a>
      <a class="sub-card" href={`${base}/training/core-training/`}>
        <span class="sub-icon">💪</span>
        <span class="sub-body">
          <strong>Dry-Land Core Training</strong>
          <span class="sub-desc">A 6-week programme for faster sprints</span>
        </span>
      </a>
      <a class="sub-card" href={`${base}/training/videos/`}>
        <span class="sub-icon">🎬</span>
        <span class="sub-body">
          <strong>Training Videos</strong>
          <span class="sub-desc">Swim England land-training library</span>
        </span>
      </a>
      <a class="sub-card" href={`${base}/training/learn-to-swim/`}>
        <span class="sub-icon">🌊</span>
        <span class="sub-body">
          <strong>Learn to Swim</strong>
          <span class="sub-desc">The pathway into our squads</span>
        </span>
      </a>
    </div>
  </div>
</section>

<!-- TIMETABLE -->
<section class="sessions" id="timetable">
  <div class="inner">
    <p class="label">Training Timetable</p>
    <p class="lead">All swimmers have an allocated swimming day and time to ensure that swimming sessions do not get congested. Please note that movement between sessions is at the discretion of the Coach and must be discussed.</p>

    <div class="sessions-note">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      All swimmers should be poolside 5 minutes before their session starts in order to start warming up.
    </div>

    {changeItems.length > 0 && (
      <div class="changes" id="session-changes">
        <div class="changes-head">
          <h3>🎄 {notice.title}</h3>
          <a class="changes-poster" href={`${base}/${notice.poster}`} target="_blank" rel="noopener">View the poster</a>
        </div>

        <div class="cal-row" style={`--months:${calendars.length}`}>
          {calendars.map((m) => (
            <div class="cal">
              <p class="cal-title">{m.title}</p>
              <div class="cal-grid">
                {['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((h) => <span class="cal-h">{h}</span>)}
                {Array.from({ length: m.blanks }, () => <span></span>)}
                {m.days.map((d) => d.href
                  ? <a class={`cal-d ${d.kind}${d.past ? ' past' : ''}`} href={d.href} title={d.title}>{d.d}</a>
                  : <span class={`cal-d ${d.kind}${d.past ? ' past' : ''}`} title={d.title}>{d.d}</span>)}
              </div>
            </div>
          ))}
        </div>
        <div class="cal-legend">
          <span><i class="normal"></i>Normal training</span>
          <span><i class="off"></i>No training</span>
          <span><i class="partial"></i>7–8pm off</span>
          <span><i class="break"></i>Christmas break</span>
          <span><i class="info"></i>Key date</span>
        </div>

        <div class="change-groups" style={`--months:${changeGroups.length}`}>
          {changeGroups.map((g) => (
            <div>
              <p class="change-month">{g.month}</p>
              <ul class="changes-list">
                {g.items.map((c) => (
                  <li class={`change ${c.kind}`} id={c.id}>
                    <span class={`tile${c.tile.range ? ' range' : ''}`} aria-hidden="true">
                      <span class="tile-m">{c.tile.top}</span>
                      <span class="tile-d">{c.tile.big}</span>
                      <span class="tile-w">{c.tile.bottom}</span>
                    </span>
                    <span class="change-body">
                      <strong>{c.what}</strong>
                      {c.why && <span class="change-why">{c.why}</span>}
                      {c.note && <span class="change-note">{c.kind === 'break' ? '' : '✓ '}{c.note}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="changes-foot">Every other day runs to the normal timetable below.</p>
      </div>
    )}

    <div class="squad-times-grid">
      {squadSessions.map((s) => (
        <div class="squad-times-card">
          <div class={`squad-times-head ${s.accent}`}>
            <h3>{s.name}</h3>
          </div>
          <p class="squad-times-desc">{s.desc}</p>
          <table class="times-table">
            <thead>
              <tr><th>Day</th><th>Time</th></tr>
            </thead>
            <tbody>
              {s.times.map((t) => (
                <tr><td>{t.day}</td><td>{t.time}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </div>

    <div class="squads-xlink">
      <p>Want to know more about our squad structure and progression pathway?</p>
      <a href={`${base}/about/squads/`}>Our Squads →</a>
    </div>
  </div>
</section>

<!-- COACHES -->
<section class="coaches" id="coaches">
  <div class="inner">
    <p class="label">Our Coaches</p>
    <p class="lead">All of our coaches are volunteers who give up their own time to support, encourage, and develop every swimmer in the club. They are not paid for the countless hours they dedicate poolside, at competitions, and behind the scenes — they do it because they genuinely care about the swimmers and want to help each individual achieve their potential.</p>
    <p class="lead" style="margin-top:16px;">Our coaches are passionate about creating a positive environment where swimmers can learn, improve, build confidence, and enjoy the sport. Their commitment goes far beyond teaching technique; they provide encouragement, guidance, and support to help swimmers grow both in and out of the pool.</p>
    <p class="lead" style="margin-top:16px;">Quite simply, if they did not care, they would not continue to give their personal time so generously. We ask that all members, swimmers, and parents show our coaching team the same respect, support, and appreciation that they consistently show to our swimmers every day.</p>

    <div class="coaches-grid">
      {coaches.map((c) => (
        <div class="coach-card">
          <div class="coach-photo">
            <img src={c.img} alt={c.name} loading="lazy" />
          </div>
          <h3>{c.name}</h3>
          <p class="coach-role">{c.role}</p>
        </div>
      ))}
    </div>

    <p class="volunteer-note">Our club also relies on volunteers who do many different roles on the committee and organising events for the club. If you are interested in helping us in any shape or form, please do get in touch — there is something for everyone.</p>
  </div>
</section>

<!-- CTA -->
<section class="page-cta">
  <h2>Ready to Start Training?</h2>
  <p>Your first session is completely free. Come and meet the coaches, see the pool, and find out which squad is the right fit for you.</p>
  <a class="btn-white" href={`${base}/about/join/`}>Book a Free Trial</a>
</section>

</BaseLayout>

<style>
  .page-hero {
    background: var(--black); padding: 64px 5vw 56px;
    position: relative; overflow: hidden;
  }
  .page-hero::after {
    content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 60px;
    background: #fff; clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .crumb { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.4); font-size: 0.78rem; margin-bottom: 18px; }
  .crumb a { color: var(--red); text-decoration: none; }
  .page-hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -1.5px; margin-bottom: 12px; }
  .page-hero p { color: rgba(255,255,255,0.65); font-size: 1rem; max-width: 580px; line-height: 1.7; margin-bottom: 32px; }
  .hero-pills { display: flex; gap: 10px; flex-wrap: wrap; }
  .pill { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.7); padding: 6px 14px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; }
  .pill svg { flex-shrink: 0; }

  .inner { max-width: 1200px; margin: 0 auto; }
  .label { font-size: 0.72rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  .lead { color: var(--muted); font-size: 1rem; line-height: 1.8; max-width: 760px; }

  /* SUB-PAGE CARDS */
  .sub-nav { background: #fff; padding: 48px 5vw; }
  .sub-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .sub-card {
    display: flex; flex-direction: row; align-items: center; gap: 16px;
    border: 1.5px solid var(--border); border-radius: 14px; padding: 20px 22px;
    text-decoration: none; color: inherit; transition: all 0.2s;
  }
  .sub-card:hover { border-color: var(--red); box-shadow: 0 8px 28px rgba(220,38,38,0.1); transform: translateY(-3px); }
  .sub-icon { font-size: 3rem; line-height: 1; flex-shrink: 0; }
  .sub-body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .sub-card strong { font-size: 0.98rem; font-weight: 800; color: var(--text); }
  .sub-desc { font-size: 0.8rem; color: var(--muted); line-height: 1.5; }

  /* TIMETABLE */
  .sessions { background: #f8fafc; padding-bottom: 48px; }
  .sessions-note {
    background: var(--red-light); border: 1.5px solid #fecaca; border-radius: 12px;
    padding: 14px 18px; color: var(--red-dark); font-size: 0.85rem; line-height: 1.6;
    margin: 24px 0 36px; display: flex; gap: 10px; align-items: flex-start; max-width: 760px;
  }
  .sessions-note svg { flex-shrink: 0; margin-top: 2px; }

  /* SESSION CHANGES */
  .changes { background: #fff; border: 1.5px solid var(--border); border-top: 4px solid var(--red); border-radius: 16px; padding: 22px 26px; margin: 0 0 36px; scroll-margin-top: 90px; }
  .changes-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
  .changes-head h3 { margin: 0; font-size: 1.15rem; font-weight: 900; letter-spacing: -0.3px; }
  .changes-poster { background: var(--red); color: #fff; text-decoration: none; padding: 8px 16px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; white-space: nowrap; }
  .changes-poster:hover { background: var(--red-dark); }
  /* Day colours, shared by the mini calendars and the legend */
  .changes { --c-normal: #e0ecfb; --c-normal-ink: #1e3a5f; --c-off: var(--red); --c-partial: #fde68a; --c-info: #16a34a; --c-break-ink: #b91c1c;
    --c-break: repeating-linear-gradient(135deg, #fecaca 0 3px, #fff5f5 3px 6px); }

  /* Three small month calendars side by side */
  .cal-row { display: grid; grid-template-columns: repeat(var(--months), minmax(0, 1fr)); gap: 12px 28px; max-width: 820px; }
  .cal-title { font-size: 0.8rem; font-weight: 900; margin: 0 0 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .cal-h { font-size: 0.6rem; font-weight: 800; color: var(--muted); text-align: center; }
  .cal-d { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border-radius: 4px; font-size: 0.68rem; line-height: 1; text-decoration: none; color: #b6bfcc; }
  .cal-d.normal { background: var(--c-normal); color: var(--c-normal-ink); font-weight: 600; }
  .cal-d.break { background: var(--c-break); color: var(--c-break-ink); }
  .cal-d.off { background: var(--c-off); color: #fff; font-weight: 800; }
  .cal-d.partial { background: var(--c-partial); color: #78350f; font-weight: 800; }
  .cal-d.info { background: var(--c-info); color: #fff; font-weight: 800; }
  .cal-d.past { opacity: 0.35; }
  a.cal-d:hover { outline: 2px solid var(--text); outline-offset: 1px; }
  .cal-legend { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 0.75rem; color: var(--muted); margin: 12px 0 4px; }
  .cal-legend i { display: inline-block; width: 11px; height: 11px; border-radius: 3px; margin-right: 5px; vertical-align: -1px; }
  .cal-legend i.normal { background: var(--c-normal); border: 1px solid #bcd3f0; }
  .cal-legend i.off { background: var(--c-off); }
  .cal-legend i.partial { background: var(--c-partial); }
  .cal-legend i.break { background: var(--c-break); border: 1px solid #fecaca; }
  .cal-legend i.info { background: var(--c-info); }

  /* The changes as calendar tiles, one column per month on wide screens */
  .change-groups { display: grid; grid-template-columns: repeat(var(--months), minmax(0, 1fr)); gap: 0 24px; align-items: start; }
  .change-month { font-size: 0.72rem; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); margin: 18px 0 8px; }
  .changes-list { list-style: none; margin: 0; padding: 0; }
  .change { display: flex; gap: 12px; align-items: stretch; margin-bottom: 10px; scroll-margin-top: 90px; }
  .change:target .change-body { outline: 2px solid var(--text); outline-offset: 1px; }
  .tile { flex: 0 0 58px; display: flex; flex-direction: column; text-align: center; border-radius: 10px; overflow: hidden; background: #fff; border: 1.5px solid var(--border); box-shadow: 0 2px 6px rgba(0,0,0,0.05); }
  .tile-m { font-size: 0.62rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: #fff; padding: 3px 0; background: var(--c-info); }
  .tile-d { font-size: 1.45rem; font-weight: 900; line-height: 1.1; padding-top: 4px; color: var(--text); }
  .tile.range .tile-d { font-size: 1rem; padding-top: 7px; }
  .tile-w { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; color: var(--muted); padding-bottom: 5px; }
  .change.off .tile-m { background: var(--c-off); }
  .change.partial .tile-m { background: #d97706; }
  .change.break .tile-m { background: #1e3a5f; }
  .change-body { flex: 1; display: flex; flex-direction: column; justify-content: center; border-radius: 10px; padding: 9px 12px; background: #fff; border: 1.5px solid var(--border); font-size: 0.9rem; }
  .change.off .change-body, .change.break .change-body { background: var(--red-light); border-color: #fecaca; }
  .change.off strong, .change.break strong { color: var(--red-dark); }
  .change-why { color: var(--muted); font-size: 0.8rem; }
  .change-note { color: #15803d; font-size: 0.78rem; margin-top: 2px; }
  .change.break .change-note { color: var(--muted); }
  .changes-foot { margin: 8px 0 0; font-size: 0.82rem; color: var(--muted); background: #f1f5f9; border-radius: 10px; padding: 10px 14px; }

  @media (max-width: 900px) {
    .change-groups { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .changes { padding: 18px 14px; }
    .cal-row { gap: 10px; }
    .cal-title { font-size: 0.68rem; }
    .cal-grid { gap: 1px; }
    .cal-h { font-size: 0.5rem; }
    .cal-d { font-size: 0.55rem; border-radius: 3px; }
  }

  .squad-times-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .squad-times-card { background: #fff; border: 1.5px solid var(--border); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; transition: all 0.25s; }
  .squad-times-card:hover { transform: translateY(-4px); box-shadow: 0 16px 50px rgba(0,0,0,0.08); }
  .squad-times-head { padding: 22px 26px; }
  .squad-times-head.dev { background: linear-gradient(135deg, #0f766e, #0d9488); }
  .squad-times-head.junior { background: linear-gradient(135deg, #4338ca, #6366f1); }
  .squad-times-head.senior { background: linear-gradient(135deg, var(--red-dark), var(--red)); }
  .squad-times-head h3 { font-size: 1.2rem; font-weight: 900; color: #fff; letter-spacing: -0.5px; margin: 0; }
  .squad-times-desc { color: var(--muted); font-size: 0.86rem; line-height: 1.7; padding: 20px 26px 16px; margin: 0; flex: 1; }
  .times-table { width: 100%; border-collapse: collapse; }
  .times-table th {
    background: #f1f5f9; color: var(--muted); font-size: 0.72rem; font-weight: 700;
    letter-spacing: 1px; text-transform: uppercase; padding: 10px 26px; text-align: left;
  }
  .times-table td { padding: 11px 26px; font-size: 0.88rem; border-top: 1px solid var(--border); }
  .times-table td:first-child { font-weight: 700; color: var(--text); }
  .times-table td:last-child { color: var(--muted); }

  .squads-xlink {
    margin-top: 36px; background: var(--black); border-radius: 16px;
    padding: 24px 30px; display: flex; align-items: center; justify-content: space-between;
    gap: 20px; flex-wrap: wrap;
  }
  .squads-xlink p { color: rgba(255,255,255,0.8); font-size: 0.95rem; font-weight: 600; margin: 0; }
  .squads-xlink a {
    background: var(--red); color: #fff; text-decoration: none; white-space: nowrap;
    padding: 11px 24px; border-radius: 10px; font-weight: 700; font-size: 0.9rem;
    transition: background 0.2s, transform 0.2s;
  }
  .squads-xlink a:hover { background: var(--red-dark); transform: translateY(-2px); }

  /* COACHES */
  .coaches { background: #fff; padding-top: 48px; }
  /* Flex, not grid: 9 coaches never fill the last row, and flex lets it centre. */
  .coaches-grid {
    --cols: 5; --gap: 24px;
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: var(--gap); margin-top: 44px;
  }
  /* Basis is deliberately a gap narrower than an exact 1/N share: an exact fit
     rounds over 100% at some widths and silently drops a card to the next row. */
  .coach-card { flex: 0 1 calc(100% / var(--cols) - var(--gap)); }
  .coach-card { background: #fff; border-radius: 16px; border: 1.5px solid var(--border); overflow: hidden; text-align: center; transition: all 0.2s; }
  .coach-card:hover { border-color: var(--red); box-shadow: 0 8px 30px rgba(220,38,38,0.1); transform: translateY(-3px); }
  .coach-photo { aspect-ratio: 4 / 5; overflow: hidden; background: #f1f5f9; }
  .coach-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s; }
  .coach-card:hover .coach-photo img { transform: scale(1.05); }
  .coach-card h3 { font-size: 1rem; font-weight: 800; margin: 14px 0 2px; }
  .coach-role { font-size: 0.78rem; font-weight: 600; color: var(--red); margin: 0 0 16px; }
  .volunteer-note { margin-top: 36px; color: var(--muted); font-size: 0.92rem; line-height: 1.7; max-width: 760px; }

  /* CTA */
  .page-cta { background: linear-gradient(135deg, var(--red-dark), var(--red)); text-align: center; padding: 72px 5vw; }
  .page-cta h2 { color: #fff; margin-bottom: 12px; }
  .page-cta p { color: rgba(255,255,255,0.9); max-width: 480px; margin: 0 auto 28px; line-height: 1.7; }
  .btn-white { background: #000; color: #fff; padding: 13px 28px; border-radius: 8px; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; display: inline-block; }
