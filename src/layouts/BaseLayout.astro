---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Torquay Leander Swimming Club', description = 'A non-profit, SwimMark registered swimming club in Torquay, Devon.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Every copy (GitHub Pages, /preview/, /rc/) names the club domain as the real page.
const canonical = new URL(Astro.url.pathname.slice(base.length) || '/', 'https://torquayleander.co.uk').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.3/dist/cdn.min.js"></script>
    <script is:inline>window.tailwind = { corePlugins: { preflight: false } }</script>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) window.lucide.createIcons();
      });
    </script>
    <!-- Enquiry forms (form[data-enquiry="membership|general"]) post to the WordPress
         plugin on the club domain (wp-preview-plugin/), which emails the club. Delegated,
         so forms Alpine renders later (the Contact page tabs) are covered too. -->
    <script is:inline>
      document.addEventListener('submit', async (e) => {
        const form = e.target.closest('form[data-enquiry]');
        if (!form) return;
        e.preventDefault();
        const button = form.querySelector('[type=submit]');
        let status = form.querySelector('.form-status');
        if (!status) {
          status = document.createElement('p');
          status.className = 'form-status';
          status.setAttribute('role', 'status');
          form.appendChild(status);
        }
        const data = new FormData(form);
        data.set('type', form.dataset.enquiry);
        data.set('page', location.href);
        // The /preview/ build and local dev go to the plugin's preview address, not the club.
        const live = /(^|\.)torquayleander\.co\.uk$|\.github\.io$/.test(location.hostname) && !/\/preview(\/|$)/.test(location.pathname);
        data.set('channel', live ? 'live' : 'preview');
        button.disabled = true;
        status.textContent = 'Sending…';
        status.classList.remove('is-error');
        let problem = "Sorry, that didn't send.";
        try {
          const res = await fetch('https://torquayleander.co.uk/wp-json/tl/v1/enquiry', { method: 'POST', body: data });
          const body = await res.json().catch(() => ({}));
          if (res.ok && body.ok) problem = null;
          else if (body.message) problem = body.message; // e.g. "Please fill in: Name."
        } catch (err) {} // offline / blocked: keep the generic message
        button.disabled = false;
        status.classList.toggle('is-error', !!problem);
        if (problem) {
          status.textContent = problem + ' You can also email us at torquayleander@hotmail.com.';
        } else {
          form.reset();
          status.textContent = 'Thanks — your message has been sent and a member of the committee will be in touch.';
        }
      });
    </script>
    <!-- Logo preview: picks made on /samples/logo/ apply to the real nav + footer.
         The live picks are baked in already — 'b1t2' in public/logo-nav.png and
         't2' in public/logo.png — so only a different pick needs swapping. -->
    <script is:inline define:vars={{ base }}>
      (function () {
        try {
          var FILES = {
            std: 'logo-b0-t0.png', b1: 'logo-b1-t0.png', b2: 'logo-b2-t0.png',
            t1: 'logo-b0-t1.png', b1t1: 'logo-b1-t1.png', b2t1: 'logo-b2-t1.png',
            t2: 'logo-b0-t2.png', b1t2: 'logo-b1-t2.png', b2t2: 'logo-b2-t2.png',
          };
          var LIVE = { nav: 'b1t2', footer: 't2' };
          var picks = JSON.parse(localStorage.getItem('logo-picks') || '{}');
          var navImg = document.querySelector('.nav-logo img');
          if (navImg && picks.nav && picks.nav !== LIVE.nav && FILES[picks.nav]) {
            navImg.src = base + '/samples/logo/' + FILES[picks.nav];
          }
          var fImg = document.querySelector('.f-logo img');
          if (fImg && picks.footer && picks.footer !== LIVE.footer && FILES[picks.footer]) {
            fImg.src = base + '/samples/logo/' + FILES[picks.footer];
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
